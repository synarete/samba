# NDR wire format ABI of eventlog.idl
#
# This is the output of ndr_abi_eventlog (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root eventlog_Record_tdb

enum eventlogEventTypes base(uint1632) {
	0x0000	# EVENTLOG_SUCCESS
	0x0001	# EVENTLOG_ERROR_TYPE
	0x0002	# EVENTLOG_WARNING_TYPE
	0x0004	# EVENTLOG_INFORMATION_TYPE
	0x0008	# EVENTLOG_AUDIT_SUCCESS
	0x0010	# EVENTLOG_AUDIT_FAILURE
}

[flag(LIBNDR_FLAG_NOALIGN|LIBNDR_PRINT_ARRAY_HEX)] struct eventlog_Record_tdb align(4) {
	scalar:uint32	# size
	[charset(DOS),value("eLfL")] array(fixed=4) scalar:uint8	# reserved
	scalar:uint32	# record_number
	scalar:time_t	# time_generated
	scalar:time_t	# time_written
	scalar:uint32	# event_id
	enum:eventlogEventTypes	# event_type
	[range(0,256)] scalar:uint16	# num_of_strings
	scalar:uint16	# event_category
	scalar:uint16	# reserved_flags
	scalar:uint32	# closing_record_number
	scalar:uint32	# stringoffset
	[value(sid.length)] scalar:uint32	# sid_length
	scalar:uint32	# sid_offset
	[value(data.length)] scalar:uint32	# data_length
	scalar:uint32	# data_offset
	[value(2*strlen_m_term(source_name))] scalar:uint32	# source_name_len
	[flag(LIBNDR_FLAG_STR_NULLTERM|LIBNDR_FLAG_ALIGN2)] scalar:string	# source_name
	[value(2*strlen_m_term(computer_name))] scalar:uint32	# computer_name_len
	[flag(LIBNDR_FLAG_STR_NULLTERM|LIBNDR_FLAG_ALIGN2)] scalar:string	# computer_name
	scalar:uint32	# sid_padding
	scalar:DATA_BLOB	# sid
	[value(2*ndr_size_string_array(strings,num_of_strings,LIBNDR_FLAG_STR_NULLTERM))] scalar:uint32	# strings_len
	[flag(LIBNDR_FLAG_STR_NULLTERM|LIBNDR_FLAG_ALIGN2)] array(inline=num_of_strings) scalar:string	# strings
	scalar:DATA_BLOB	# data
	scalar:uint32	# padding
}

