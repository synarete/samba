# NDR wire format ABI of fsrvp_state.idl
#
# This is the output of ndr_abi_fsrvp_state (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root fsrvp_state_smap
root fsrvp_state_sc
root fsrvp_state_sc_set

struct fsrvp_state_sc align(4) {
	[flag(LIBNDR_FLAG_STR_UTF8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# id_str
	[flag(LIBNDR_FLAG_STR_UTF8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# volume_name
	[flag(LIBNDR_FLAG_STR_UTF8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# sc_path
	scalar:time_t	# create_ts
	scalar:int32	# smaps_count
}

struct fsrvp_state_sc_set align(4) {
	[flag(LIBNDR_FLAG_STR_UTF8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# id_str
	scalar:int32	# state
	scalar:int32	# context
	scalar:int32	# scs_count
}

struct fsrvp_state_smap align(4) {
	[flag(LIBNDR_FLAG_STR_UTF8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# share_name
	[flag(LIBNDR_FLAG_STR_UTF8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# sc_share_name
	[flag(LIBNDR_FLAG_STR_UTF8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# sc_share_comment
	scalar:uint32	# is_exposed
}

sample fsrvp_state_smap length(52) {
	[0000] 73 74 72 69 6e 67 30 30  30 30 30 30 30 31 00 73
	[0010] 74 72 69 6e 67 30 30 30  30 30 30 30 32 00 73 74
	[0020] 72 69 6e 67 30 30 30 30  30 30 30 33 00 00 00 00
	[0030] 04 05 06 07
}
