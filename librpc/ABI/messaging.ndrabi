	default: EMPTY
}

struct messaging_debuglevel_v1 align(4) {
	[flag(LIBNDR_FLAG_STR_UTF8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# debuglevel_string
}

enum messaging_debuglevel_version_values base(uint32) {
	0x00000001	# MESSAGING_DEBUGLEVEL_VERSION_1
}

enum messaging_dmalloc_version_values base(uint32) {
	0x00000001	# MESSAGING_DMALLOC_VERSION_1
}

[flag(LIBNDR_FLAG_NOALIGN)] struct messaging_hdr align(8) {
	struct:server_id	# dest
	struct:server_id	# src
	scalar:uint32	# msg_type
}

union messaging_id_cacheU align(4) switch_type(enum:messaging_id_cache_version_values) {
