root messaging_rec
root messaging_reclog
root messaging_hdr

struct messaging_debug align(4) {
	[value(MESSAGING_DEBUG_VERSION_1)] enum:messaging_debug_version_values	# version
	[value(0)] scalar:uint32	# reserved
	switch(version) union:messaging_debugU	# info
}

union messaging_debugU align(4) switch_type(enum:messaging_debug_version_values) {
	case(MESSAGING_DEBUG_VERSION_1): struct:messaging_debug_v1	# info1
	default: EMPTY
}

struct messaging_debug_v1 align(4) {
	[flag(LIBNDR_FLAG_STR_UTF8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# debug_string
}

enum messaging_debug_version_values base(uint32) {
	0x00000001	# MESSAGING_DEBUG_VERSION_1
}

struct messaging_debuglevel align(4) {
	[value(MESSAGING_DEBUGLEVEL_VERSION_1)] enum:messaging_debuglevel_version_values	# version
