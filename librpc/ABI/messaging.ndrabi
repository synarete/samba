# NDR wire format ABI of messaging.idl
#
# This is the output of ndr_abi_messaging (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root messaging_type
root messaging_debug_version_values
root messaging_debug
root messaging_debuglevel_version_values
root messaging_req_debuglevel
root messaging_debuglevel
root messaging_profile_version_values
