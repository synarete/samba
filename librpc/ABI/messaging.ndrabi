# NDR wire format ABI of messaging.idl
#
# This is the output of ndr_abi_messaging (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root messaging_type
root messaging_rec
root messaging_reclog

struct messaging_rec align(8) {
	scalar:uint32	# msg_version
	enum:messaging_type	# msg_type
	struct:server_id	# dest
	struct:server_id	# src
	scalar:DATA_BLOB	# buf
	scalar:uint8	# num_fds
	array(inline=num_fds) scalar:dlong	# fds
}

struct messaging_reclog align(8) {
	scalar:hyper	# rec_index
	scalar:uint32	# num_recs
	array(inline=num_recs) ptr(unique) struct:messaging_rec	# recs
}

enum messaging_type base(uint32) {
	0x0001	# MSG_DEBUG
	0x0002	# MSG_PING
	0x0003	# MSG_PONG
	0x0004	# MSG_PROFILE
	0x0005	# MSG_REQ_DEBUGLEVEL
	0x0006	# MSG_DEBUGLEVEL
	0x0007	# MSG_REQ_PROFILELEVEL
	0x0008	# MSG_PROFILELEVEL
	0x0009	# MSG_REQ_POOL_USAGE
	0x000B	# MSG_REQ_DMALLOC_MARK
	0x000C	# MSG_REQ_DMALLOC_LOG_CHANGED
	0x000D	# MSG_SHUTDOWN
	0x000F	# ID_CACHE_DELETE
	0x0010	# ID_CACHE_KILL
	0x0021	# MSG_SMB_CONF_UPDATED
	0x0022	# MSG_RELOAD_TLS_CERTIFICATES
	0x0033	# MSG_REQ_RINGBUF_LOG
	0x0034	# MSG_RINGBUF_LOG
	0x0035	# MSG_DAEMON_READY_FD
	0x0040	# MSG_CLUSTER_LEVEL_UPGRADED
	0x0101	# MSG_FORCE_ELECTION
	0x0102	# MSG_WINS_NEW_ENTRY
	0x0103	# MSG_SEND_PACKET
	0x0202	# MSG_PRINTER_NOTIFY2
	0x0203	# MSG_PRINTER_DRVUPGRADE
	0x0205	# MSG_PRINTER_UPDATE
	0x0207	# MSG_PRINTER_PCAP
	0x0302	# MSG_SMB_FORCE_TDIS
	0x0306	# MSG_SMB_BREAK_REQUEST
	0x030A	# MSG_SMB_KERNEL_BREAK
	0x030B	# MSG_SMB_FILE_RENAME
	0x030C	# MSG_SMB_INJECT_FAULT
	0x030E	# MSG_SMB_NOTIFY
	0x0310	# MSG_PVFS_NOTIFY
	0x0313	# MSG_SMB_CLOSE_FILE
	0x0314	# MSG_SMB_NOTIFY_CLEANUP
	0x0315	# MSG_SMB_SCAVENGER
	0x0316	# MSG_SMB_KILL_CLIENT_IP
	0x0317	# MSG_SMB_TELL_NUM_CHILDREN
	0x0318	# MSG_SMB_NUM_CHILDREN
	0x0319	# MSG_SMB_NOTIFY_CANCEL_DELETED
	0x031A	# MSG_SMB_NOTIFY_REC_CHANGE
	0x031B	# MSG_SMB_NOTIFY_TRIGGER
	0x031C	# MSG_SMB_NOTIFY_GET_DB
	0x031D	# MSG_SMB_NOTIFY_DB
	0x031E	# MSG_SMB_NOTIFY_REC_CHANGES
	0x031F	# MSG_SMB_NOTIFY_STARTED
	0x0320	# MSG_SMB_SLEEP
	0x0321	# MSG_SMB_FORCE_TDIS_DENIED
	0x0322	# MSG_SMB_IP_DROPPED
	0x0403	# MSG_WINBIND_ONLINE
	0x0404	# MSG_WINBIND_OFFLINE
	0x0405	# MSG_WINBIND_ONLINESTATUS
	0x0408	# MSG_WINBIND_VALIDATE_CACHE
	0x0409	# MSG_WINBIND_DUMP_DOMAIN_LIST
	0x040A	# MSG_WINBIND_IP_DROPPED
	0x040B	# MSG_WINBIND_DOMAIN_ONLINE
	0x040C	# MSG_WINBIND_DOMAIN_OFFLINE
	0x040D	# MSG_WINBIND_RELOAD_TRUSTED_DOMAINS
	0x040E	# MSG_WINBIND_DISCONNECT_DC
	0x0600	# MSG_SMBXSRV_SESSION_CLOSE
	0x0601	# MSG_SMBXSRV_CONNECTION_PASS
	0x0602	# MSG_SMBXSRV_CONNECTION_PASSED
	0x0603	# MSG_SMBXSRV_CONNECTION_DROP
	0x0680	# MSG_RPCD_WITNESS_REGISTRATION_UPDATE
	0x0700	# MSG_BRL_RETRY
	0x0701	# MSG_PVFS_RETRY_OPEN
	0x0702	# MSG_IRPC
	0x0703	# MSG_NTVFS_OPLOCK_BREAK
	0x0704	# MSG_DREPL_ALLOCATE_RID
	0x0800	# MSG_AUTH_LOG
	0x0801	# MSG_DSDB_LOG
	0x0802	# MSG_DSDB_PWD_LOG
	0x0803	# MSG_GROUP_LOG
	0x0900	# MSG_VFS_AIO_RATELIMIT_READ_NODE_SUMMARY
	0x0901	# MSG_VFS_AIO_RATELIMIT_WRITE_NODE_SUMMARY
	4003	# MSG_DBWRAP_MODIFIED
	4004	# MSG_RPC_HOST_NEW_CLIENT
	4005	# MSG_RPC_WORKER_STATUS
	4006	# MSG_RPC_DUMP_STATUS
	4007	# MSG_RPC_WORKER_INFO
	0xF000	# MSG_TMP_BASE
}

struct server_id align(8) {
	scalar:hyper	# pid
	scalar:uint32	# task_id
	scalar:uint32	# vnn
	scalar:hyper	# unique_id
}

