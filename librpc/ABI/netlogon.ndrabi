# NDR wire format ABI of netlogon.idl
#
# This is the output of ndr_abi_netlogon (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root netr_DsRGetDCNameInfo

struct GUID align(4) {
	scalar:uint32	# time_low
	scalar:uint16	# time_mid
	scalar:uint16	# time_hi_and_version
	array(fixed=2) scalar:uint8	# clock_seq
	array(fixed=6) scalar:uint8	# node
}

bitmap nbt_server_type base(uint32) {
	0	# NBT_SERVER_PDC ( 0x00000001 )
	1	# NBT_SERVER_GC ( 0x00000004 )
	2	# NBT_SERVER_LDAP ( 0x00000008 )
	3	# NBT_SERVER_DS ( 0x00000010 )
	4	# NBT_SERVER_KDC ( 0x00000020 )
	5	# NBT_SERVER_TIMESERV ( 0x00000040 )
	6	# NBT_SERVER_CLOSEST ( 0x00000080 )
	7	# NBT_SERVER_WRITABLE ( 0x00000100 )
	8	# NBT_SERVER_GOOD_TIMESERV ( 0x00000200 )
	9	# NBT_SERVER_NDNC ( 0x00000400 )
	10	# NBT_SERVER_SELECT_SECRET_DOMAIN_6 ( 0x00000800 )
	11	# NBT_SERVER_FULL_SECRET_DOMAIN_6 ( 0x00001000 )
	12	# NBT_SERVER_ADS_WEB_SERVICE ( 0x00002000 )
	13	# NBT_SERVER_DS_8 ( 0x00004000 )
	14	# NBT_SERVER_DS_9 ( 0x00008000 )
	15	# NBT_SERVER_DS_10 ( 0x00010000 )
	16	# NBT_SERVER_HAS_DNS_NAME ( 0x20000000 )
	17	# NBT_SERVER_IS_DEFAULT_NC ( 0x40000000 )
	18	# NBT_SERVER_FOREST_ROOT ( 0x80000000 )
}

struct netr_DsRGetDCNameInfo align(5) {
	[charset(UTF16)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint16	# dc_unc
	[charset(UTF16)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint16	# dc_address
	enum:netr_DsRGetDCNameInfo_AddressType	# dc_address_type
	struct:GUID	# domain_guid
	[charset(UTF16)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint16	# domain_name
	[charset(UTF16)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint16	# forest_name
	bitmap:nbt_server_type	# dc_flags
	[charset(UTF16)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint16	# dc_site_name
	[charset(UTF16)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint16	# client_site_name
}

enum netr_DsRGetDCNameInfo_AddressType base(uint32) {
	1	# DS_ADDRESS_TYPE_INET
	2	# DS_ADDRESS_TYPE_NETBIOS
}

