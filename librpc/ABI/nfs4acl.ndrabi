# NDR wire format ABI of nfs4acl.idl
#
# This is the output of ndr_abi_nfs4acl (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root nfs4acl

[flag(LIBNDR_FLAG_BIGENDIAN)] struct nfs4ace align(4) {
	scalar:uint16	# e_type
	scalar:uint16	# e_flags
	scalar:uint32	# e_mask
	scalar:uint32	# e_id
	[flag(LIBNDR_FLAG_STR_UTF8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# e_who
	[flag(LIBNDR_FLAG_ALIGN4)] scalar:DATA_BLOB	# _pad
}

[flag(LIBNDR_FLAG_BIGENDIAN)] struct nfs4acl align(4) {
	scalar:uint8	# a_version
	scalar:uint8	# a_flags
	scalar:uint16	# a_count
	scalar:uint32	# a_owner_mask
	scalar:uint32	# a_group_mask
	scalar:uint32	# a_other_mask
	array(inline=a_count) struct:nfs4ace	# ace
}

sample nfs4acl length(72) {
	[0000] 01 02 00 02 06 05 04 03  07 06 05 04 08 07 06 05
	[0010] 07 06 08 07 0b 0a 09 08  0c 0b 0a 09 73 74 72 69
	[0020] 6e 67 30 30 30 30 30 30  31 30 00 00 10 0f 11 10
	[0030] 14 13 12 11 15 14 13 12  73 74 72 69 6e 67 30 30
	[0040] 30 30 30 30 31 39 00 00
}
#	    nfs4acl: struct nfs4acl
#	        a_version                : 0x01 (1)
#	        a_flags                  : 0x02 (2)
#	        a_count                  : 0x0002 (2)
#	        a_owner_mask             : 0x06050403 (100992003)
#	        a_group_mask             : 0x07060504 (117835012)
#	        a_other_mask             : 0x08070605 (134678021)
#	        ace: ARRAY(2)
#	            ace: struct nfs4ace
#	                e_type                   : 0x0706 (1798)
#	                e_flags                  : 0x0807 (2055)
#	                e_mask                   : 0x0b0a0908 (185207048)
#	                e_id                     : 0x0c0b0a09 (202050057)
#	                e_who                    : 'string00000010'
#	                _pad                     : DATA_BLOB length=1
#	[0000] 00                                                  .
#	            ace: struct nfs4ace
#	                e_type                   : 0x100f (4111)
#	                e_flags                  : 0x1110 (4368)
#	                e_mask                   : 0x14131211 (336794129)
#	                e_id                     : 0x15141312 (353637138)
#	                e_who                    : 'string00000019'
#	                _pad                     : DATA_BLOB length=1
#	[0000] 00                                                  .

sample nfs4acl@minimal length(16) {
	[0000] 01 02 00 00 06 05 04 03  07 06 05 04 08 07 06 05
}
