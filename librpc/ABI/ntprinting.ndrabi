# NDR wire format ABI of ntprinting.idl
#
# This is the output of ndr_abi_ntprinting (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root ntprinting_form
root ntprinting_driver
root ntprinting_devicemode
root ntprinting_printer_data
root ntprinting_printer_info
root ntprinting_printer

[flag(LIBNDR_FLAG_NOALIGN)] struct ntprinting_devicemode align(8) {
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# devicename
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# formname
	scalar:uint16	# specversion
	scalar:uint16	# driverversion
	scalar:uint16	# size
	scalar:uint16	# driverextra
	scalar:uint16	# orientation
	scalar:uint16	# papersize
	scalar:uint16	# paperlength
	scalar:uint16	# paperwidth
	scalar:uint16	# scale
	scalar:uint16	# copies
	scalar:uint16	# defaultsource
	scalar:uint16	# printquality
	scalar:uint16	# color
	scalar:uint16	# duplex
	scalar:uint16	# yresolution
	scalar:uint16	# ttoption
	scalar:uint16	# collate
	scalar:uint16	# logpixels
	scalar:uint32	# fields
	scalar:uint32	# bitsperpel
	scalar:uint32	# pelswidth
	scalar:uint32	# pelsheight
	scalar:uint32	# displayflags
	scalar:uint32	# displayfrequency
	scalar:uint32	# icmmethod
	scalar:uint32	# icmintent
	scalar:uint32	# mediatype
	scalar:uint32	# dithertype
	scalar:uint32	# reserved1
	scalar:uint32	# reserved2
	scalar:uint32	# panningwidth
	scalar:uint32	# panningheight
	ptr(unique) scalar:DATA_BLOB	# nt_dev_private
}

[flag(LIBNDR_FLAG_NOALIGN)] struct ntprinting_driver align(8) {
	scalar:uint32	# version
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# name
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# environment
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# driverpath
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# datafile
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# configfile
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# helpfile
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# monitorname
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# defaultdatatype
	[flag((ndr_ntprinting_string_flags(r->string_flags)&~LIBNDR_FLAG_STR_NULLTERM)|LIBNDR_FLAG_STR_NOTERM|LIBNDR_FLAG_REMAINING)] scalar:string_array	# dependent_files
}

[flag(LIBNDR_FLAG_NOALIGN)] struct ntprinting_form align(4) {
	scalar:uint32	# position
	scalar:uint32	# flag
	scalar:uint32	# width
	scalar:uint32	# length
	scalar:uint32	# left
	scalar:uint32	# top
	scalar:uint32	# right
	scalar:uint32	# bottom
}

[flag(LIBNDR_FLAG_NOALIGN),nopull] struct ntprinting_printer align(8) {
	struct:ntprinting_printer_info	# info
	ptr(unique) struct:ntprinting_devicemode	# devmode
	scalar:uint32	# count
	array(inline=count) struct:ntprinting_printer_data	# printer_data
}

[flag(LIBNDR_FLAG_NOALIGN)] struct ntprinting_printer_data align(8) {
	scalar:uint32	# ptr
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# name
	scalar:uint32	# type
	scalar:DATA_BLOB	# data
}

[flag(LIBNDR_FLAG_NOALIGN)] struct ntprinting_printer_info align(8) {
	scalar:uint32	# attributes
	scalar:uint32	# priority
	scalar:uint32	# default_priority
	scalar:uint32	# starttime
	scalar:uint32	# untiltime
	scalar:uint32	# status
	scalar:uint32	# cjobs
	scalar:uint32	# averageppm
	scalar:uint32	# changeid
	scalar:uint32	# c_setprinter
	scalar:uint32	# setuptime
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# servername
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# printername
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# sharename
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# portname
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# drivername
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# comment
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# location
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# sepfile
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# printprocessor
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# datatype
	[flag(ndr_ntprinting_string_flags(r->string_flags))] scalar:string	# parameters
}

