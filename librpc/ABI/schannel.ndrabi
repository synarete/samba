# NDR wire format ABI of schannel.idl
#
# This is the output of ndr_abi_schannel (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root netlogon_creds_CredentialState

struct GUID align(4) {
	scalar:uint32	# time_low
	scalar:uint16	# time_mid
	scalar:uint16	# time_hi_and_version
	array(fixed=2) scalar:uint8	# clock_seq
	array(fixed=6) scalar:uint8	# node
}

[nopull,nopush] struct dom_sid align(4) {
	scalar:uint8	# sid_rev_num
	[range(0,15)] scalar:int8	# num_auths
	array(fixed=6) scalar:uint8	# id_auth
	array(fixed=15) scalar:uint32	# sub_auths
}

external dom_sid28

[flag(LIBNDR_PRINT_ARRAY_HEX)] struct netlogon_creds_CredentialState align(8) {
	[value(0)] scalar:uint32	# zero_flags
	[flag(LIBNDR_FLAG_IS_SECRET)] array(fixed=16) scalar:uint8	# session_key
	scalar:uint32	# sequence
	struct:netr_Credential	# seed
	struct:netr_Credential	# client
	struct:netr_Credential	# server
	enum:netr_SchannelType	# secure_channel_type
	[charset(UTF8)] array(conformant,varying,zero_terminated) scalar:uint8	# computer_name
	[charset(UTF8)] array(conformant,varying,zero_terminated) scalar:uint8	# account_name
	[value(0xFFFFFFFF)] scalar:uint32	# magic1
	[value(0xFFFFFFFF)] scalar:uint32	# magic2
	bitmap:netr_NegotiateFlags	# negotiate_flags
	bitmap:netr_NegotiateFlags	# client_requested_flags
	scalar:NTTIME	# auth_time
	[value(0xFFFFFFFF)] scalar:uint32	# magic3
	external:dom_sid28	# client_sid
	struct:GUID	# tdo_guid
	scalar:uint8	# authenticate_kerberos
	[value(0)] scalar:hyper	# reserved2
	[value(NULL)] ptr(unique) struct:netlogon_creds_CredentialState_extra_info	# ex
}

[flag(LIBNDR_PRINT_ARRAY_HEX)] struct netlogon_creds_CredentialState_extra_info align(4) {
	struct:dom_sid	# dummy_sid
}

[flag(LIBNDR_PRINT_ARRAY_HEX)] struct netr_Credential align(1) {
	array(fixed=8) scalar:uint8	# data
}

bitmap netr_NegotiateFlags base(uint32) {
	0	# NETLOGON_NEG_ACCOUNT_LOCKOUT ( 0x00000001 )
	1	# NETLOGON_NEG_PERSISTENT_SAMREPL ( 0x00000002 )
	2	# NETLOGON_NEG_ARCFOUR ( 0x00000004 )
	3	# NETLOGON_NEG_PROMOTION_COUNT ( 0x00000008 )
	4	# NETLOGON_NEG_CHANGELOG_BDC ( 0x00000010 )
	5	# NETLOGON_NEG_FULL_SYNC_REPL ( 0x00000020 )
	6	# NETLOGON_NEG_MULTIPLE_SIDS ( 0x00000040 )
	7	# NETLOGON_NEG_REDO ( 0x00000080 )
	8	# NETLOGON_NEG_PASSWORD_CHANGE_REFUSAL ( 0x00000100 )
	9	# NETLOGON_NEG_SEND_PASSWORD_INFO_PDC ( 0x00000200 )
	10	# NETLOGON_NEG_GENERIC_PASSTHROUGH ( 0x00000400 )
	11	# NETLOGON_NEG_CONCURRENT_RPC ( 0x00000800 )
	12	# NETLOGON_NEG_AVOID_ACCOUNT_DB_REPL ( 0x00001000 )
	13	# NETLOGON_NEG_AVOID_SECURITYAUTH_DB_REPL ( 0x00002000 )
	14	# NETLOGON_NEG_STRONG_KEYS ( 0x00004000 )
	15	# NETLOGON_NEG_TRANSITIVE_TRUSTS ( 0x00008000 )
	16	# NETLOGON_NEG_DNS_DOMAIN_TRUSTS ( 0x00010000 )
	17	# NETLOGON_NEG_PASSWORD_SET2 ( 0x00020000 )
	18	# NETLOGON_NEG_GETDOMAININFO ( 0x00040000 )
	19	# NETLOGON_NEG_CROSS_FOREST_TRUSTS ( 0x00080000 )
	20	# NETLOGON_NEG_NEUTRALIZE_NT4_EMULATION ( 0x00100000 )
	21	# NETLOGON_NEG_RODC_PASSTHROUGH ( 0x00200000 )
	22	# NETLOGON_NEG_SUPPORTS_AES_SHA2 ( 0x00400000 )
	23	# NETLOGON_NEG_SUPPORTS_AES ( 0x01000000 )
	24	# NETLOGON_NEG_AUTHENTICATED_RPC_LSASS ( 0x20000000 )
	25	# NETLOGON_NEG_AUTHENTICATED_RPC ( 0x40000000 )
	26	# NETLOGON_NEG_SUPPORTS_KERBEROS_AUTH ( 0x80000000 )
}

enum netr_SchannelType base(uint1632) {
	0	# SEC_CHAN_NULL
	1	# SEC_CHAN_LOCAL
	2	# SEC_CHAN_WKSTA
	3	# SEC_CHAN_DNS_DOMAIN
	4	# SEC_CHAN_DOMAIN
	5	# SEC_CHAN_LANMAN
	6	# SEC_CHAN_BDC
	7	# SEC_CHAN_RODC
}

