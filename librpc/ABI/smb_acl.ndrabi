# NDR wire format ABI of smb_acl.idl
#
# This is the output of ndr_abi_smb_acl (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root smb_acl_t
root smb_acl_wrapper

struct smb_acl_entry align(8) {
	enum:smb_acl_tag_t	# a_type
	switch(a_type) union:smb_acl_entry_info	# info
	scalar:uint32	# a_perm
}

union smb_acl_entry_info align(8) switch_type(scalar:uint16) {
	case(SMB_ACL_USER): struct:smb_acl_user	# user
	case(SMB_ACL_USER_OBJ): EMPTY
	case(SMB_ACL_GROUP): struct:smb_acl_group	# group
	case(SMB_ACL_GROUP_OBJ): EMPTY
	case(SMB_ACL_OTHER): EMPTY
	case(SMB_ACL_MASK): EMPTY
}

struct smb_acl_group align(8) {
	scalar:gid_t	# gid
}

struct smb_acl_t align(8) {
	scalar:int32	# count
	[value(0)] scalar:int32	# next
	array(conformant=count,surrounding) struct:smb_acl_entry	# acl
}

enum smb_acl_tag_t base(uint1632) {
	0	# SMB_ACL_TAG_INVALID
	1	# SMB_ACL_USER
	2	# SMB_ACL_USER_OBJ
	3	# SMB_ACL_GROUP
	4	# SMB_ACL_GROUP_OBJ
	5	# SMB_ACL_OTHER
	6	# SMB_ACL_MASK
}

struct smb_acl_user align(8) {
	scalar:uid_t	# uid
}

struct smb_acl_wrapper align(8) {
	ptr(unique) struct:smb_acl_t	# access_acl
	ptr(unique) struct:smb_acl_t	# default_acl
	scalar:uid_t	# owner
	scalar:gid_t	# group
	scalar:uint32	# mode
}

sample smb_acl_t length(60) {
	[0000] 02 00 00 00 00 00 00 00  02 00 00 00 00 00 00 00
	[0010] 01 00 01 00 00 00 00 00  01 02 03 04 00 00 00 00
	[0020] 02 03 04 05 00 00 00 00  01 00 01 00 00 00 00 00
	[0030] 03 04 05 06 00 00 00 00  04 05 06 07
}
#	    smb_acl_t: struct smb_acl_t
#	        count                    : 2
#	        next                     : 0
#	        acl: ARRAY(2)
#	            acl: struct smb_acl_entry
#	                a_type                   : SMB_ACL_USER (1)
#	                info                     : union smb_acl_entry_info(case 1)
#	                user: struct smb_acl_user
#	                    uid                      : 0x0000000004030201 (67305985)
#	                a_perm                   : 0x05040302 (84148994)
#	            acl: struct smb_acl_entry
#	                a_type                   : SMB_ACL_USER (1)
#	                info                     : union smb_acl_entry_info(case 1)
#	                user: struct smb_acl_user
#	                    uid                      : 0x0000000006050403 (100992003)
#	                a_perm                   : 0x07060504 (117835012)

