root spoolss_DeviceMode

struct spoolss_DeviceMode align(4) {
	[charset(UTF16),to_null] array(inline=MAXDEVICENAME,to_null) scalar:uint16	# devicename
	enum:spoolss_DeviceModeSpecVersion	# specversion
	scalar:uint16	# driverversion
	scalar:uint16	# size
	[value(r->driverextra_data.length)] scalar:uint16	# __driverextra_length
	bitmap:spoolss_DeviceModeFields	# fields
	enum:spoolss_DeviceModeOrientation	# orientation
	enum:spoolss_DeviceModePaperSize	# papersize
	scalar:uint16	# paperlength
	scalar:uint16	# paperwidth
	scalar:uint16	# scale
	scalar:uint16	# copies
	enum:spoolss_DeviceModeDefaultSource	# defaultsource
	enum:spoolss_DeviceModePrintQuality	# printquality
	enum:spoolss_DeviceModeColor	# color
	enum:spoolss_DeviceModeDuplex	# duplex
	scalar:uint16	# yresolution
	enum:spoolss_DeviceModeTTOption	# ttoption
	enum:spoolss_DeviceModeCollate	# collate
	[charset(UTF16),to_null] array(inline=MAXDEVICENAME,to_null) scalar:uint16	# formname
	scalar:uint16	# logpixels
	scalar:uint32	# bitsperpel
	scalar:uint32	# pelswidth
	scalar:uint32	# pelsheight
	enum:spoolss_DeviceModeNUp	# displayflags
	scalar:uint32	# displayfrequency
	enum:spoolss_DeviceModeICMMethod	# icmmethod
	enum:spoolss_DeviceModeICMIntent	# icmintent
	enum:spoolss_DeviceModeMediaType	# mediatype
	enum:spoolss_DeviceModeDitherType	# dithertype
	scalar:uint32	# reserved1
	scalar:uint32	# reserved2
	scalar:uint32	# panningwidth
	scalar:uint32	# panningheight
	[flag(LIBNDR_FLAG_REMAINING)] subcontext(0,__driverextra_length) scalar:DATA_BLOB	# driverextra_data
}

