# NDR wire format ABI of xattr.idl
#
# This is the output of ndr_abi_xattr (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root xattr_DosInfo
root xattr_DosAttrib
root xattr_DOSATTRIB
root xattr_DosEAs
root tdb_xattrs
root xattr_DosStreams
root security_descriptor_hash_v2
root security_descriptor_hash_v3
root security_descriptor_hash_v4
root xattr_NTACL
root xattr_sys_acl_hash_wrapper

struct CLAIM_SECURITY_ATTRIBUTE_RELATIVE_V1 align(5) {
	[flag(LIBNDR_FLAG_STR_NULLTERM|LIBNDR_FLAG_ALIGN2)] ptr(relative) scalar:string	# name
	scalar:uint16	# value_type
	scalar:uint32	# flags
	scalar:uint32	# value_count
	array(inline=value_count) switch(value_type) union:claim_values	# values
}

struct GUID align(4) {
	scalar:uint32	# time_low
	scalar:uint16	# time_mid
	scalar:uint16	# time_hi_and_version
	array(fixed=2) scalar:uint8	# clock_seq
	array(fixed=6) scalar:uint8	# node
}

[flag(LIBNDR_FLAG_NOALIGN),nodiscriminant] union claim_values align(5) {
	case(CLAIM_SECURITY_ATTRIBUTE_TYPE_INT64): ptr(relative) scalar:int64	# int_value
	case(CLAIM_SECURITY_ATTRIBUTE_TYPE_UINT64): ptr(relative) scalar:hyper	# uint_value
	case(CLAIM_SECURITY_ATTRIBUTE_TYPE_STRING): [flag(LIBNDR_FLAG_STR_NULLTERM|LIBNDR_FLAG_ALIGN2)] ptr(relative) scalar:string	# string_value
	case(CLAIM_SECURITY_ATTRIBUTE_TYPE_SID): ptr(relative) scalar:DATA_BLOB	# sid_value
	case(CLAIM_SECURITY_ATTRIBUTE_TYPE_OCTET_STRING): ptr(relative) scalar:DATA_BLOB	# octet_value
	case(CLAIM_SECURITY_ATTRIBUTE_TYPE_BOOLEAN): ptr(relative) scalar:hyper	# uint_value
}

[nopull,nopush] struct dom_sid align(4) {
	scalar:uint8	# sid_rev_num
	[range(0,15)] scalar:int8	# num_auths
	array(fixed=6) scalar:uint8	# id_auth
	array(fixed=15) scalar:uint32	# sub_auths
}

[nopull,nopush] struct security_ace align(5) {
	enum:security_ace_type	# type
	bitmap:security_ace_flags	# flags
	[value(ndr_size_security_ace(r,ndr->flags))] scalar:uint16	# size
	scalar:uint32	# access_mask
	switch(sec_ace_object(type)) union:security_ace_object_ctr	# object
	struct:dom_sid	# trustee
	subcontext(0,ndr_subcontext_size_of_ace_coda(r,size,ndr->flags)) switch(type) union:security_ace_coda	# coda
}

[nodiscriminant] union security_ace_coda align(5) {
	case(SEC_ACE_TYPE_ACCESS_ALLOWED_CALLBACK): [flag(LIBNDR_FLAG_REMAINING)] scalar:DATA_BLOB	# conditions
	case(SEC_ACE_TYPE_ACCESS_DENIED_CALLBACK): [flag(LIBNDR_FLAG_REMAINING)] scalar:DATA_BLOB	# conditions
	case(SEC_ACE_TYPE_ACCESS_ALLOWED_CALLBACK_OBJECT): [flag(LIBNDR_FLAG_REMAINING)] scalar:DATA_BLOB	# conditions
	case(SEC_ACE_TYPE_ACCESS_DENIED_CALLBACK_OBJECT): [flag(LIBNDR_FLAG_REMAINING)] scalar:DATA_BLOB	# conditions
	case(SEC_ACE_TYPE_SYSTEM_AUDIT_CALLBACK): [flag(LIBNDR_FLAG_REMAINING)] scalar:DATA_BLOB	# conditions
	case(SEC_ACE_TYPE_SYSTEM_AUDIT_CALLBACK_OBJECT): [flag(LIBNDR_FLAG_REMAINING)] scalar:DATA_BLOB	# conditions
	case(SEC_ACE_TYPE_SYSTEM_RESOURCE_ATTRIBUTE): struct:CLAIM_SECURITY_ATTRIBUTE_RELATIVE_V1	# claim
	default: [flag(LIBNDR_FLAG_REMAINING)] scalar:DATA_BLOB	# ignored
}

bitmap security_ace_flags base(uint8) {
	0	# SEC_ACE_FLAG_OBJECT_INHERIT ( 0x01 )
	1	# SEC_ACE_FLAG_CONTAINER_INHERIT ( 0x02 )
	2	# SEC_ACE_FLAG_NO_PROPAGATE_INHERIT ( 0x04 )
	3	# SEC_ACE_FLAG_INHERIT_ONLY ( 0x08 )
	4	# SEC_ACE_FLAG_INHERITED_ACE ( 0x10 )
	5	# SEC_ACE_FLAG_VALID_INHERIT ( 0x0f )
	6	# SEC_ACE_FLAG_SUCCESSFUL_ACCESS ( 0x40 )
	7	# SEC_ACE_FLAG_FAILED_ACCESS ( 0x80 )
}

struct security_ace_object align(4) {
	bitmap:security_ace_object_flags	# flags
	switch(flags&SEC_ACE_OBJECT_TYPE_PRESENT) union:security_ace_object_type	# type
	switch(flags&SEC_ACE_INHERITED_OBJECT_TYPE_PRESENT) union:security_ace_object_inherited_type	# inherited_type
}

[nodiscriminant] union security_ace_object_ctr align(4) {
	default: struct:security_ace_object	# object
	case(false): EMPTY
}

bitmap security_ace_object_flags base(uint32) {
	0	# SEC_ACE_OBJECT_TYPE_PRESENT ( 0x00000001 )
	1	# SEC_ACE_INHERITED_OBJECT_TYPE_PRESENT ( 0x00000002 )
}

[nodiscriminant] union security_ace_object_inherited_type align(4) {
	case(SEC_ACE_INHERITED_OBJECT_TYPE_PRESENT): struct:GUID	# inherited_type
	default: EMPTY
}

[nodiscriminant] union security_ace_object_type align(4) {
	case(SEC_ACE_OBJECT_TYPE_PRESENT): struct:GUID	# type
	default: EMPTY
}

enum security_ace_type base(uint8) {
	0	# SEC_ACE_TYPE_ACCESS_ALLOWED
	1	# SEC_ACE_TYPE_ACCESS_DENIED
	2	# SEC_ACE_TYPE_SYSTEM_AUDIT
	3	# SEC_ACE_TYPE_SYSTEM_ALARM
	4	# SEC_ACE_TYPE_ALLOWED_COMPOUND
	5	# SEC_ACE_TYPE_ACCESS_ALLOWED_OBJECT
	6	# SEC_ACE_TYPE_ACCESS_DENIED_OBJECT
	7	# SEC_ACE_TYPE_SYSTEM_AUDIT_OBJECT
	8	# SEC_ACE_TYPE_SYSTEM_ALARM_OBJECT
	9	# SEC_ACE_TYPE_ACCESS_ALLOWED_CALLBACK
	10	# SEC_ACE_TYPE_ACCESS_DENIED_CALLBACK
	11	# SEC_ACE_TYPE_ACCESS_ALLOWED_CALLBACK_OBJECT
	12	# SEC_ACE_TYPE_ACCESS_DENIED_CALLBACK_OBJECT
	13	# SEC_ACE_TYPE_SYSTEM_AUDIT_CALLBACK
	14	# SEC_ACE_TYPE_SYSTEM_ALARM_CALLBACK
	15	# SEC_ACE_TYPE_SYSTEM_AUDIT_CALLBACK_OBJECT
	16	# SEC_ACE_TYPE_SYSTEM_ALARM_CALLBACK_OBJECT
	17	# SEC_ACE_TYPE_SYSTEM_MANDATORY_LABEL
	18	# SEC_ACE_TYPE_SYSTEM_RESOURCE_ATTRIBUTE
	19	# SEC_ACE_TYPE_SYSTEM_SCOPED_POLICY_ID
}

struct security_acl align(5) {
	enum:security_acl_revision	# revision
	[value(ndr_size_security_acl(r,ndr->flags))] scalar:uint16	# size
	[range(0,2000)] scalar:uint32	# num_aces
	array(inline=num_aces) struct:security_ace	# aces
}

enum security_acl_revision base(uint1632) {
	2	# SECURITY_ACL_REVISION_NT4
	4	# SECURITY_ACL_REVISION_ADS
}

[flag(LIBNDR_FLAG_LITTLE_ENDIAN)] struct security_descriptor align(5) {
	enum:security_descriptor_revision	# revision
	bitmap:security_descriptor_type	# type
	ptr(relative) struct:dom_sid	# owner_sid
	ptr(relative) struct:dom_sid	# group_sid
	ptr(relative) struct:security_acl	# sacl
	ptr(relative) struct:security_acl	# dacl
}

struct security_descriptor_hash_v2 align(5) {
	ptr(unique) struct:security_descriptor	# sd
	array(fixed=16) scalar:uint8	# hash
}

struct security_descriptor_hash_v3 align(5) {
	ptr(unique) struct:security_descriptor	# sd
	scalar:uint16	# hash_type
	array(fixed=64) scalar:uint8	# hash
}

struct security_descriptor_hash_v4 align(5) {
	ptr(unique) struct:security_descriptor	# sd
	scalar:uint16	# hash_type
	array(fixed=64) scalar:uint8	# hash
	[flag(LIBNDR_FLAG_STR_UTF8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# description
	scalar:NTTIME	# time
	array(fixed=64) scalar:uint8	# sys_acl_hash
}

enum security_descriptor_revision base(uint8) {
	1	# SECURITY_DESCRIPTOR_REVISION_1
}

bitmap security_descriptor_type base(uint16) {
	0	# SEC_DESC_OWNER_DEFAULTED ( 0x0001 )
	1	# SEC_DESC_GROUP_DEFAULTED ( 0x0002 )
	2	# SEC_DESC_DACL_PRESENT ( 0x0004 )
	3	# SEC_DESC_DACL_DEFAULTED ( 0x0008 )
	4	# SEC_DESC_SACL_PRESENT ( 0x0010 )
	5	# SEC_DESC_SACL_DEFAULTED ( 0x0020 )
	6	# SEC_DESC_DACL_TRUSTED ( 0x0040 )
	7	# SEC_DESC_SERVER_SECURITY ( 0x0080 )
	8	# SEC_DESC_DACL_AUTO_INHERIT_REQ ( 0x0100 )
	9	# SEC_DESC_SACL_AUTO_INHERIT_REQ ( 0x0200 )
	10	# SEC_DESC_DACL_AUTO_INHERITED ( 0x0400 )
	11	# SEC_DESC_SACL_AUTO_INHERITED ( 0x0800 )
	12	# SEC_DESC_DACL_PROTECTED ( 0x1000 )
	13	# SEC_DESC_SACL_PROTECTED ( 0x2000 )
	14	# SEC_DESC_RM_CONTROL_VALID ( 0x4000 )
	15	# SEC_DESC_SELF_RELATIVE ( 0x8000 )
}

struct tdb_xattrs align(4) {
	scalar:uint32	# num_eas
	array(inline=num_eas) struct:xattr_EA	# eas
}

[nopull,nopush] struct xattr_DOSATTRIB align(4) {
	[flag(LIBNDR_FLAG_STR_ASCII|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# attrib_hex
	scalar:uint16	# version
	switch(version) union:xattr_DosInfo	# info
}

struct xattr_DosAttrib align(4) {
	scalar:uint16	# version
	switch(version) union:xattr_DosInfo	# info
}

struct xattr_DosEAs align(5) {
	scalar:uint16	# num_eas
	ptr(unique) array(conformant=num_eas) struct:xattr_EA	# eas
}

union xattr_DosInfo align(4) switch_type(scalar:uint16) {
	case(0xFFFF): struct:xattr_DosInfoFFFFCompat	# compatinfoFFFF
	case(1): struct:xattr_DosInfo1	# info1
	case(2): struct:xattr_DosInfo2Old	# oldinfo2
	case(3): struct:xattr_DosInfo3	# info3
	case(4): struct:xattr_DosInfo4	# info4
	case(5): struct:xattr_DosInfo5	# info5
}

struct xattr_DosInfo1 align(4) {
	scalar:uint32	# attrib
	scalar:uint32	# ea_size
	scalar:udlong	# size
	scalar:udlong	# alloc_size
	scalar:NTTIME	# create_time
	scalar:NTTIME	# change_time
}

struct xattr_DosInfo2Old align(4) {
	scalar:uint32	# flags
	scalar:uint32	# attrib
	scalar:uint32	# ea_size
	scalar:udlong	# size
	scalar:udlong	# alloc_size
	scalar:NTTIME	# create_time
	scalar:NTTIME	# change_time
	scalar:NTTIME	# write_time
	[flag(LIBNDR_FLAG_STR_UTF8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# name
}

struct xattr_DosInfo3 align(4) {
	bitmap:xattr_DosInfoValidFlags	# valid_flags
	scalar:uint32	# attrib
	scalar:uint32	# ea_size
	scalar:udlong	# size
	scalar:udlong	# alloc_size
	scalar:NTTIME	# create_time
	scalar:NTTIME	# change_time
}

struct xattr_DosInfo4 align(4) {
	bitmap:xattr_DosInfoValidFlags	# valid_flags
	scalar:uint32	# attrib
	scalar:NTTIME	# itime
	scalar:NTTIME	# create_time
}

struct xattr_DosInfo5 align(4) {
	bitmap:xattr_DosInfoValidFlags	# valid_flags
	scalar:uint32	# attrib
	scalar:NTTIME	# create_time
}

struct xattr_DosInfoFFFFCompat align(4) {
	scalar:uint32	# attrib
}

bitmap xattr_DosInfoValidFlags base(uint32) {
	0	# XATTR_DOSINFO_ATTRIB ( 0x00000001 )
	1	# XATTR_DOSINFO_EA_SIZE ( 0x00000002 )
	2	# XATTR_DOSINFO_SIZE ( 0x00000004 )
	3	# XATTR_DOSINFO_ALLOC_SIZE ( 0x00000008 )
	4	# XATTR_DOSINFO_CREATE_TIME ( 0x00000010 )
	5	# XATTR_DOSINFO_CHANGE_TIME ( 0x00000020 )
	6	# XATTR_DOSINFO_ITIME ( 0x00000040 )
}

struct xattr_DosStream align(4) {
	scalar:uint32	# flags
	scalar:udlong	# size
	scalar:udlong	# alloc_size
	[flag(LIBNDR_FLAG_STR_UTF8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# name
}

struct xattr_DosStreams align(5) {
	scalar:uint32	# num_streams
	ptr(unique) array(conformant=num_streams) struct:xattr_DosStream	# streams
}

struct xattr_EA align(4) {
	[flag(LIBNDR_FLAG_STR_UTF8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# name
	scalar:DATA_BLOB	# value
}

struct xattr_NTACL align(5) {
	scalar:uint16	# version
	switch(version) union:xattr_NTACL_Info	# info
}

union xattr_NTACL_Info align(5) switch_type(scalar:uint16) {
	case(1): ptr(unique) struct:security_descriptor	# sd
	case(2): ptr(unique) struct:security_descriptor_hash_v2	# sd_hs2
	case(3): ptr(unique) struct:security_descriptor_hash_v3	# sd_hs3
	case(4): ptr(unique) struct:security_descriptor_hash_v4	# sd_hs4
}

struct xattr_sys_acl_hash_wrapper align(8) {
	scalar:DATA_BLOB	# acl_as_blob
	scalar:uid_t	# owner
	scalar:gid_t	# group
	scalar:uint32	# mode
}

sample xattr_DosAttrib length(8) {
	[0000] ff ff ff ff 01 02 03 04
}
