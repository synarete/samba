/*
 * same struct as file_id, but with hyper instead
 * of udlong in NDR, see librpc/ndr/ndr_file_id.c
 */
cpp_quote("#define file_id_hyper file_id")

/*
 * same struct as file_id, but only devid and inode
 * are on the wire, see librpc/ndr/ndr_file_id.c
 */
cpp_quote("#define file_id_devino file_id")

[
	pointer_default(unique),
	helper("../librpc/ndr/ndr_file_id.h")
]
interface file_id
{
	/*
	 * This is part of many records in databases and
	 * messages and also sent on its own as
	 * MSG_SMB_NOTIFY_CANCEL_DELETED (possibly to
	 * other nodes in a ctdb cluster), so the NDR
	 * wire format is protected by librpc/ABI/file_id.ndrabi,
	 * see librpc/ndr/ndr_abi.h
	 */
	typedef [public,ndr_abi] struct {
		/* we don't use SMB_DEV_T and SMB_INO_T as we want a fixed size here,
		   and we may be using file system specific code to fill in something
		   other than a dev_t for the device */
		udlong devid;
		udlong inode;
		udlong extid; /* Support systems that use an extended id (e.g. snapshots). */
	} file_id;

	/*
	 * The key for locking.tdb and brlock.tdb is the
	 * layout of the raw C structure in host byte order,
	 * see push_file_id_24() and pull_file_id_24().
	 *
	 * Keys can't be versioned like records or messages,
	 * all processes in the cluster need to use the same key,
	 * so changing this would require a cluster wide switch.
	 */
	const uint32 FILE_ID_KEY_LENGTH = 24;
	typedef [public,ndr_abi] struct {
		file_id_hyper id;
	} file_id_key;
}
