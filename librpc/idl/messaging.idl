#include "idl_types.h"

import "server_id.idl";

/*
   IDL structures for messaging code
*/

[
  pointer_default(unique)
]
interface messaging
{
	const int MSG_TYPE_MASK = 0xFFFF;

	typedef [v1_enum,public] enum {

		/* MSG_DEBUG */
		MSG_DEBUG			= 0x0001,
		MSG_PING			= 0x0002,
		MSG_PONG			= 0x0003,
		MSG_PROFILE			= 0x0004,
		MSG_REQ_DEBUGLEVEL		= 0x0005,
		MSG_DEBUGLEVEL			= 0x0006,
		MSG_REQ_PROFILELEVEL		= 0x0007,
		MSG_PROFILELEVEL		= 0x0008,
		MSG_REQ_POOL_USAGE		= 0x0009,
		/* MSG_POOL_USAGE		= 0x000A,  Obsoleted */

		/* If dmalloc is included, set a steady-state mark */
		MSG_REQ_DMALLOC_MARK		= 0x000B,

		/* If dmalloc is included, dump to the dmalloc log a description of
		 * what has changed since the last MARK */
		MSG_REQ_DMALLOC_LOG_CHANGED	= 0x000C,
		MSG_SHUTDOWN			= 0x000D,

		/* ID_CACHE_FLUSH		= 0x000E,  Obsoleted */
		ID_CACHE_DELETE			= 0x000F,
		ID_CACHE_KILL			= 0x0010,

		/* Changes to smb.conf are really of general interest */
		MSG_SMB_CONF_UPDATED		= 0x0021,
		MSG_RELOAD_TLS_CERTIFICATES	= 0x0022,

		/* MSG_PREFORK_CHILD_EVENT	= 0x0031,  Obsoleted */
		/* MSG_PREFORK_PARENT_EVENT	= 0x0032,  Obsoleted */

		MSG_REQ_RINGBUF_LOG		= 0x0033,
		MSG_RINGBUF_LOG			= 0x0034,

		MSG_DAEMON_READY_FD             = 0x0035,

		/* This sends an empty message */
		MSG_CLUSTER_LEVEL_UPGRADED	= 0x0040,

		/* nmbd messages */
		MSG_FORCE_ELECTION		= 0x0101,
		MSG_WINS_NEW_ENTRY		= 0x0102,
		MSG_SEND_PACKET			= 0x0103,

		/* printing messages */
		/* MSG_PRINTER_NOTIFY		= 0x2001,  Obsoleted */
		MSG_PRINTER_NOTIFY2		= 0x0202,
		MSG_PRINTER_DRVUPGRADE		= 0x0203,
		/* MSG_PRINTERDATA_INIT_RESET	= 0x0204,  Obsoleted */
		MSG_PRINTER_UPDATE		= 0x0205,
		/* MSG_PRINTER_MOD		= 0x0206,  Obsoleted */
		MSG_PRINTER_PCAP		= 0x0207,

		/* smbd messages */
		/* MSG_SMB_CONF_UPDATED		= 0x0301,  Obsoleted */
		MSG_SMB_FORCE_TDIS		= 0x0302,
		/* MSG_SMB_SAM_SYNC		= 0x0303,  Obsoleted */
		/* MSG_SMB_SAM_REPL		= 0x0304,  Obsoleted */
		/* MSG_SMB_UNLOCK		= 0x0305,  Obsoleted */
		MSG_SMB_BREAK_REQUEST		= 0x0306,
		/* MSG_SMB_BREAK_RESPONSE	= 0x0307,  Obsoleted */
		/* MSG_SMB_ASYNC_LEVEL2_BREAK	= 0x0308,  Obsoleted */
		/* MSG_SMB_OPEN_RETRY		= 0x0309,  Obsoleted */
		MSG_SMB_KERNEL_BREAK		= 0x030A,
		MSG_SMB_FILE_RENAME		= 0x030B,
		MSG_SMB_INJECT_FAULT		= 0x030C,
		/* MSG_SMB_BLOCKING_LOCK_CANCEL	= 0x030D,  Obsoleted */
		MSG_SMB_NOTIFY			= 0x030E,
		/* MSG_SMB_STAT_CACHE_DELETE	= 0x030F,  Obsoleted */

		/* Samba4 compatibility */
		MSG_PVFS_NOTIFY			= 0x0310,

		/* cluster reconfigure events */
		/* MSG_SMB_BRL_VALIDATE		= 0x0311,  Obsoleted */

		/*Close a specific file given a share entry. */
		MSG_SMB_CLOSE_FILE		= 0x0313,

		/* Trigger a notify cleanup run */
		MSG_SMB_NOTIFY_CLEANUP		= 0x0314,
		MSG_SMB_SCAVENGER		= 0x0315,

		/* shutdown connection for given client */
		MSG_SMB_KILL_CLIENT_IP		= 0x0316,

		/* Tell number of child processes */
		MSG_SMB_TELL_NUM_CHILDREN       = 0x0317,
		MSG_SMB_NUM_CHILDREN            = 0x0318,

		/* Cancel a notify, directory got deleted */
		MSG_SMB_NOTIFY_CANCEL_DELETED   = 0x0319,

		/* notifyd messages */
		MSG_SMB_NOTIFY_REC_CHANGE	= 0x031A,
		MSG_SMB_NOTIFY_TRIGGER		= 0x031B,
		MSG_SMB_NOTIFY_GET_DB		= 0x031C,
		MSG_SMB_NOTIFY_DB		= 0x031D,
		MSG_SMB_NOTIFY_REC_CHANGES	= 0x031E,
		MSG_SMB_NOTIFY_STARTED          = 0x031F,
		MSG_SMB_SLEEP			= 0x0320,

		/* smbd message */
		MSG_SMB_FORCE_TDIS_DENIED	= 0x0321,

		/* smbd ip dropped message */
		MSG_SMB_IP_DROPPED		= 0x0322,

		/* winbind messages */
		/* MSG_WINBIND_FINISHED		= 0x0401,  Obsoleted */
		/* MSG_WINBIND_FORGET_STATE	= 0x0402,  Obsoleted */
		MSG_WINBIND_ONLINE		= 0x0403,
		MSG_WINBIND_OFFLINE		= 0x0404,
		MSG_WINBIND_ONLINESTATUS	= 0x0405,

		MSG_WINBIND_VALIDATE_CACHE	= 0x0408,
		MSG_WINBIND_DUMP_DOMAIN_LIST	= 0x0409,
		MSG_WINBIND_IP_DROPPED		= 0x040A,
		MSG_WINBIND_DOMAIN_ONLINE	= 0x040B,
		MSG_WINBIND_DOMAIN_OFFLINE	= 0x040C,
		MSG_WINBIND_RELOAD_TRUSTED_DOMAINS = 0x040D,
		MSG_WINBIND_DISCONNECT_DC       = 0x040E,

		/* event messages */
		/* MSG_DUMP_EVENT_LIST		= 0x0500,  Obsoleted */

		/* smbXsrv messages */
		MSG_SMBXSRV_SESSION_CLOSE	= 0x0600,
		MSG_SMBXSRV_CONNECTION_PASS	= 0x0601,
		MSG_SMBXSRV_CONNECTION_PASSED	= 0x0602,
		MSG_SMBXSRV_CONNECTION_DROP	= 0x0603,

		/* rpcd_witness messages */
		MSG_RPCD_WITNESS_REGISTRATION_UPDATE = 0x0680,

		/* source4 and NTVFS smb server messages */
		MSG_BRL_RETRY                   = 0x0700,
		MSG_PVFS_RETRY_OPEN             = 0x0701,
		MSG_IRPC                        = 0x0702,
		MSG_NTVFS_OPLOCK_BREAK          = 0x0703,
		MSG_DREPL_ALLOCATE_RID          = 0x0704,

		/*
		 * Audit, Authentication and Authorisation event
		 * messages
		 */
		MSG_AUTH_LOG                    = 0x0800,
		MSG_DSDB_LOG                    = 0x0801,
		MSG_DSDB_PWD_LOG                = 0x0802,
		MSG_GROUP_LOG                   = 0x0803,

		/*
		 * VFS aio_ratelimit cluster coordination messages
		 * Node-level aggregation via ratelimitd daemon
		 */
		MSG_VFS_AIO_RATELIMIT_READ_NODE_SUMMARY	= 0x0900,
		MSG_VFS_AIO_RATELIMIT_WRITE_NODE_SUMMARY = 0x0901,

		/* dbwrap messages 4001-4999 (0x0FA0 - 0x1387) */
		/* MSG_DBWRAP_TDB2_CHANGES		= 4001, */
		/* MSG_DBWRAP_G_LOCK_RETRY		= 4002, */
		MSG_DBWRAP_MODIFIED		= 4003,

		MSG_RPC_HOST_NEW_CLIENT         = 4004,
		MSG_RPC_WORKER_STATUS           = 4005,
		MSG_RPC_DUMP_STATUS             = 4006,
		MSG_RPC_WORKER_INFO             = 4007,

		/*
		 * source4 allows new messages to be registered at
		 * runtime (currently used in python bindings and in
		 * smbtorture). Temporary messaging endpoints are
		 * allocated above this line
		 */
		MSG_TMP_BASE                    = 0xF000
	} messaging_type;

	/* MSG_DEBUG */
	typedef [public, v1_enum] enum {
		MESSAGING_DEBUG_VERSION_0 = 0x00000000
	} messaging_debug_version_values;

	const uint32 MESSAGING_DEBUG_VERSION_CURRENT =
		MESSAGING_DEBUG_VERSION_0;

	typedef [public] struct {
		[skip] messaging_debug_version_values version;
		utf8string debug_string;
	} messaging_debug;

	/* MSG_PROFILE */
	typedef [public, v1_enum] enum {
		MESSAGING_PROFILE_VERSION_0 = 0x00000000
	} messaging_profile_version_values;

	const uint32 MESSAGING_PROFILE_VERSION_CURRENT =
		MESSAGING_PROFILE_VERSION_0;

	/* MSG_PING / MSG_PONG */
	typedef [public, v1_enum] enum {
		MESSAGING_PING_VERSION_0 = 0x00000000
	} messaging_ping_version_values;

	const uint32 MESSAGING_PING_VERSION_CURRENT =
		MESSAGING_PING_VERSION_0;

	typedef [public] struct {
		messaging_ping_version_values version;
		utf8string payload;
	} messaging_ping;

	typedef [public] struct {
		messaging_ping_version_values version;
	} messaging_pong;

	typedef [public] struct {
		[skip] messaging_profile_version_values version;
		uint32 level;
	} messaging_profile;

	/* MSG_REQ_DEBUGLEVEL / MSG_DEBUGLEVEL */
	typedef [public, v1_enum] enum {
		MESSAGING_DEBUGLEVEL_VERSION_0 = 0x00000000
	} messaging_debuglevel_version_values;

	const uint32 MESSAGING_DEBUGLEVEL_VERSION_CURRENT =
		MESSAGING_DEBUGLEVEL_VERSION_0;

	/* MSG_REQ_PROFILELEVEL / MSG_PROFILELEVEL */
	typedef [public, v1_enum] enum {
		MESSAGING_PROFILELEVEL_VERSION_0 = 0x00000000
	} messaging_profilelevel_version_values;

	const uint32 MESSAGING_PROFILELEVEL_VERSION_CURRENT =
		MESSAGING_PROFILELEVEL_VERSION_0;

	/* MSG_REQ_POOL_USAGE */
	typedef [public, v1_enum] enum {
		MESSAGING_REQ_POOL_USAGE_VERSION_0 = 0x00000000
	} messaging_req_pool_usage_version_values;

	const uint32 MESSAGING_REQ_POOL_USAGE_VERSION_CURRENT =
		MESSAGING_REQ_POOL_USAGE_VERSION_0;

	typedef [public] struct {
		[skip] messaging_req_pool_usage_version_values version;
	} messaging_req_pool_usage;

	/* MSG_SHUTDOWN */
	typedef [public, v1_enum] enum {
		MESSAGING_SHUTDOWN_VERSION_0 = 0x00000000
	} messaging_shutdown_version_values;

	const uint32 MESSAGING_SHUTDOWN_VERSION_CURRENT =
		MESSAGING_SHUTDOWN_VERSION_0;

	typedef [public] struct {
		[skip] messaging_shutdown_version_values version;
	} messaging_shutdown;

	/* ID_CACHE_DELETE / ID_CACHE_KILL */
	typedef [public, v1_enum] enum {
		MESSAGING_ID_CACHE_VERSION_0 = 0x00000000
	} messaging_id_cache_version_values;

	const uint32 MESSAGING_ID_CACHE_VERSION_CURRENT =
		MESSAGING_ID_CACHE_VERSION_0;

	typedef [public] struct {
		[skip] messaging_id_cache_version_values version;
		utf8string id;
	} messaging_id_cache_delete;

	typedef [public] struct {
		[skip] messaging_id_cache_version_values version;
		utf8string id;
	} messaging_id_cache_kill;

	/* MSG_SMB_CONF_UPDATED */
	typedef [public, v1_enum] enum {
		MESSAGING_SMB_CONF_UPDATED_VERSION_0 = 0x00000000
	} messaging_smb_conf_updated_version_values;

	const uint32 MESSAGING_SMB_CONF_UPDATED_VERSION_CURRENT =
		MESSAGING_SMB_CONF_UPDATED_VERSION_0;

	typedef [public] struct {
		[skip] messaging_smb_conf_updated_version_values version;
	} messaging_smb_conf_updated;

	/* MSG_RELOAD_TLS_CERTIFICATES */
	typedef [public, v1_enum] enum {
		MESSAGING_RELOAD_TLS_CERTIFICATES_VERSION_0 = 0x00000000
	} messaging_reload_tls_certificates_version_values;

	const uint32 MESSAGING_RELOAD_TLS_CERTIFICATES_VERSION_CURRENT =
		MESSAGING_RELOAD_TLS_CERTIFICATES_VERSION_0;

	typedef [public] struct {
		[skip] messaging_reload_tls_certificates_version_values version;
	} messaging_reload_tls_certificates;

	/* MSG_REQ_RINGBUF_LOG / MSG_RINGBUF_LOG */
	typedef [public, v1_enum] enum {
		MESSAGING_RINGBUF_LOG_VERSION_0 = 0x00000000
	} messaging_ringbuf_log_version_values;

	const uint32 MESSAGING_RINGBUF_LOG_VERSION_CURRENT =
		MESSAGING_RINGBUF_LOG_VERSION_0;

	typedef [public] struct {
		[skip] messaging_ringbuf_log_version_values version;
	} messaging_req_ringbuf_log;

	typedef [public] struct {
		[skip] messaging_ringbuf_log_version_values version;
		utf8string log;
	} messaging_ringbuf_log;

	/* MSG_DAEMON_READY_FD */
	typedef [public, v1_enum] enum {
		MESSAGING_DAEMON_READY_FD_VERSION_0 = 0x00000000
	} messaging_daemon_ready_fd_version_values;

	const uint32 MESSAGING_DAEMON_READY_FD_VERSION_CURRENT =
		MESSAGING_DAEMON_READY_FD_VERSION_0;

	typedef [public] struct {
		[skip] messaging_daemon_ready_fd_version_values version;
	} messaging_daemon_ready_fd;

	/* MSG_SMB_KILL_CLIENT_IP */
	typedef [public, v1_enum] enum {
		MESSAGING_KILL_CLIENT_IP_VERSION_0 = 0x00000000
	} messaging_kill_client_ip_version_values;

	const uint32 MESSAGING_KILL_CLIENT_IP_VERSION_CURRENT =
		MESSAGING_KILL_CLIENT_IP_VERSION_0;

	typedef [public] struct {
		messaging_kill_client_ip_version_values version;
		utf8string ip;
	} messaging_kill_client_ip;

	/* MSG_SMB_FORCE_TDIS / MSG_SMB_FORCE_TDIS_DENIED */
	typedef [public, v1_enum] enum {
		MESSAGING_FORCE_TDIS_VERSION_0 = 0x00000000
	} messaging_force_tdis_version_values;

	const uint32 MESSAGING_FORCE_TDIS_VERSION_CURRENT =
		MESSAGING_FORCE_TDIS_VERSION_0;

	typedef [public] struct {
		messaging_force_tdis_version_values version;
		utf8string sharename;
	} messaging_force_tdis;

	typedef [public] struct {
		messaging_force_tdis_version_values version;
		utf8string sharename;
	} messaging_force_tdis_denied;

	/* MSG_WINBIND_ONLINE / MSG_WINBIND_OFFLINE */
	typedef [public, v1_enum] enum {
		MESSAGING_WINBIND_ONLINE_OFFLINE_VERSION_0 = 0x00000000
	} messaging_winbind_online_offline_version_values;

	const uint32 MESSAGING_WINBIND_ONLINE_OFFLINE_VERSION_CURRENT =
		MESSAGING_WINBIND_ONLINE_OFFLINE_VERSION_0;

	typedef [public] struct {
		messaging_winbind_online_offline_version_values version;
		utf8string domain_name;
	} messaging_winbind_online;

	typedef [public] struct {
		messaging_winbind_online_offline_version_values version;
		utf8string domain_name;
	} messaging_winbind_offline;

	/* MSG_WINBIND_DOMAIN_ONLINE / MSG_WINBIND_DOMAIN_OFFLINE */
	typedef [public] struct {
		messaging_winbind_online_offline_version_values version;
		utf8string domain_name;
	} messaging_winbind_domain_online;

	typedef [public] struct {
		messaging_winbind_online_offline_version_values version;
		utf8string domain_name;
	} messaging_winbind_domain_offline;

	/* MSG_WINBIND_RELOAD_TRUSTED_DOMAINS */
	typedef [public, v1_enum] enum {
		MESSAGING_WINBIND_RELOAD_TRUSTED_DOMAINS_VERSION_0 = 0x00000000
	} messaging_winbind_reload_trusted_domains_version_values;

	const uint32 MESSAGING_WINBIND_RELOAD_TRUSTED_DOMAINS_VERSION_CURRENT =
		MESSAGING_WINBIND_RELOAD_TRUSTED_DOMAINS_VERSION_0;

	typedef [public] struct {
		messaging_winbind_reload_trusted_domains_version_values version;
	} messaging_winbind_reload_trusted_domains;

	/* MSG_WINBIND_DISCONNECT_DC */
	typedef [public, v1_enum] enum {
		MESSAGING_WINBIND_DISCONNECT_DC_VERSION_0 = 0x00000000
	} messaging_winbind_disconnect_dc_version_values;

	const uint32 MESSAGING_WINBIND_DISCONNECT_DC_VERSION_CURRENT =
		MESSAGING_WINBIND_DISCONNECT_DC_VERSION_0;

	typedef [public] struct {
		messaging_winbind_disconnect_dc_version_values version;
	} messaging_winbind_disconnect_dc;

	/* MSG_WINBIND_VALIDATE_CACHE */
	typedef [public, v1_enum] enum {
		MESSAGING_WINBIND_VALIDATE_CACHE_VERSION_0 = 0x00000000
	} messaging_winbind_validate_cache_version_values;

	const uint32 MESSAGING_WINBIND_VALIDATE_CACHE_VERSION_CURRENT =
		MESSAGING_WINBIND_VALIDATE_CACHE_VERSION_0;

	typedef [public] struct {
		messaging_winbind_validate_cache_version_values version;
		server_id reply_to;
	} messaging_winbind_validate_cache_req;

	typedef [public] struct {
		messaging_winbind_validate_cache_version_values version;
		uint8 retval;
	} messaging_winbind_validate_cache_reply;

	/* MSG_WINBIND_ONLINESTATUS */
	typedef [public, v1_enum] enum {
		MESSAGING_WINBIND_ONLINESTATUS_VERSION_0 = 0x00000000
	} messaging_winbind_onlinestatus_version_values;

	const uint32 MESSAGING_WINBIND_ONLINESTATUS_VERSION_CURRENT =
		MESSAGING_WINBIND_ONLINESTATUS_VERSION_0;

	typedef [public] struct {
		messaging_winbind_onlinestatus_version_values version;
	} messaging_winbind_onlinestatus_req;

	typedef [public] struct {
		messaging_winbind_onlinestatus_version_values version;
		utf8string status;
	} messaging_winbind_onlinestatus_reply;

	/* MSG_WINBIND_DUMP_DOMAIN_LIST */
	typedef [public, v1_enum] enum {
		MESSAGING_WINBIND_DUMP_DOMAIN_LIST_VERSION_0 = 0x00000000
	} messaging_winbind_dump_domain_list_version_values;

	const uint32 MESSAGING_WINBIND_DUMP_DOMAIN_LIST_VERSION_CURRENT =
		MESSAGING_WINBIND_DUMP_DOMAIN_LIST_VERSION_0;

	typedef [public] struct {
		messaging_winbind_dump_domain_list_version_values version;
		utf8string domain;
	} messaging_winbind_dump_domain_list_req;

	typedef [public] struct {
		messaging_winbind_dump_domain_list_version_values version;
		utf8string dump;
	} messaging_winbind_dump_domain_list_reply;

	/* MSG_PRINTER_PCAP */
	typedef [public, v1_enum] enum {
		MESSAGING_PRINTER_PCAP_VERSION_0 = 0x00000000
	} messaging_printer_pcap_version_values;

	const uint32 MESSAGING_PRINTER_PCAP_VERSION_CURRENT =
		MESSAGING_PRINTER_PCAP_VERSION_0;

	typedef [public] struct {
		messaging_printer_pcap_version_values version;
	} messaging_printer_pcap;

	/* MSG_SMB_INJECT_FAULT */
	typedef [public, v1_enum] enum {
		MESSAGING_SMB_INJECT_FAULT_VERSION_0 = 0x00000000
	} messaging_smb_inject_fault_version_values;

	const uint32 MESSAGING_SMB_INJECT_FAULT_VERSION_CURRENT =
		MESSAGING_SMB_INJECT_FAULT_VERSION_0;

	typedef [public] struct {
		messaging_smb_inject_fault_version_values version;
		int32 fault_code;
	} messaging_smb_inject_fault;

	/* MSG_SMB_TELL_NUM_CHILDREN / MSG_SMB_NUM_CHILDREN */
	typedef [public, v1_enum] enum {
		MESSAGING_SMB_NUM_CHILDREN_VERSION_0 = 0x00000000
	} messaging_smb_num_children_version_values;

	const uint32 MESSAGING_SMB_NUM_CHILDREN_VERSION_CURRENT =
		MESSAGING_SMB_NUM_CHILDREN_VERSION_0;

	typedef [public] struct {
		messaging_smb_num_children_version_values version;
	} messaging_smb_tell_num_children;

	typedef [public] struct {
		messaging_smb_num_children_version_values version;
		uint32 num_children;
	} messaging_smb_num_children;

	/* MSG_SMB_NOTIFY_CLEANUP / MSG_SMB_NOTIFY_STARTED / MSG_SMB_NOTIFY_GET_DB */
	typedef [public, v1_enum] enum {
		MESSAGING_SMB_NOTIFY_VERSION_0 = 0x00000000
	} messaging_smb_notify_version_values;

	const uint32 MESSAGING_SMB_NOTIFY_VERSION_CURRENT =
		MESSAGING_SMB_NOTIFY_VERSION_0;

	typedef [public] struct {
		messaging_smb_notify_version_values version;
	} messaging_smb_notify_cleanup;

	typedef [public] struct {
		messaging_smb_notify_version_values version;
	} messaging_smb_notify_started;

	typedef [public] struct {
		messaging_smb_notify_version_values version;
	} messaging_smb_notify_get_db;

	/* MSG_SMB_SLEEP */
	typedef [public, v1_enum] enum {
		MESSAGING_SMB_SLEEP_VERSION_0 = 0x00000000
	} messaging_smb_sleep_version_values;

	const uint32 MESSAGING_SMB_SLEEP_VERSION_CURRENT =
		MESSAGING_SMB_SLEEP_VERSION_0;

	typedef [public] struct {
		messaging_smb_sleep_version_values version;
		uint32 seconds;
	} messaging_smb_sleep;

	/* MSG_SMB_IP_DROPPED / MSG_WINBIND_IP_DROPPED */
	typedef [public, v1_enum] enum {
		MESSAGING_IP_DROPPED_VERSION_0 = 0x00000000
	} messaging_ip_dropped_version_values;

	const uint32 MESSAGING_IP_DROPPED_VERSION_CURRENT =
		MESSAGING_IP_DROPPED_VERSION_0;

	typedef [public] struct {
		messaging_ip_dropped_version_values version;
		utf8string ip;
	} messaging_smb_ip_dropped;

	typedef [public] struct {
		messaging_ip_dropped_version_values version;
		utf8string ip;
	} messaging_winbind_ip_dropped;

	/* MSG_FORCE_ELECTION */
	typedef [public, v1_enum] enum {
		MESSAGING_FORCE_ELECTION_VERSION_0 = 0x00000000
	} messaging_force_election_version_values;

	const uint32 MESSAGING_FORCE_ELECTION_VERSION_CURRENT =
		MESSAGING_FORCE_ELECTION_VERSION_0;

	typedef [public] struct {
		messaging_force_election_version_values version;
	} messaging_force_election;

	/* MSG_REQ_DMALLOC_MARK / MSG_REQ_DMALLOC_LOG_CHANGED */
	typedef [public, v1_enum] enum {
		MESSAGING_REQ_DMALLOC_VERSION_0 = 0x00000000
	} messaging_req_dmalloc_version_values;

	const uint32 MESSAGING_REQ_DMALLOC_VERSION_CURRENT =
		MESSAGING_REQ_DMALLOC_VERSION_0;

	typedef [public] struct {
		[skip] messaging_req_dmalloc_version_values version;
	} messaging_req_dmalloc_mark;

	typedef [public] struct {
		[skip] messaging_req_dmalloc_version_values version;
	} messaging_req_dmalloc_log_changed;

	typedef [public] struct {
		[skip] messaging_profilelevel_version_values version;
	} messaging_req_profilelevel;

	typedef [public] struct {
		[skip] messaging_profilelevel_version_values version;
		uint32 level;
	} messaging_profilelevel;

	typedef [public] struct {
		[skip] messaging_debuglevel_version_values version;
	} messaging_req_debuglevel;

	typedef [public] struct {
		[skip] messaging_debuglevel_version_values version;
		utf8string debuglevel_string;
	} messaging_debuglevel;

	/* messaging struct sent across the sockets and stored in the tdb */

	typedef [public] struct {
		[skip] messaging_rec *prev;
		[skip] messaging_rec *next;
		uint32 msg_version;
		messaging_type msg_type;
		server_id dest;
		server_id src;
		DATA_BLOB buf;
		uint8 num_fds;
		dlong fds[num_fds];
	} messaging_rec;

	typedef [public] struct {
		hyper rec_index;
		uint32 num_recs;
		messaging_rec *recs[num_recs];
	} messaging_reclog;

        /* This allows this well known service name to be referenced in python and C */
        const string AUTH_EVENT_NAME  = "auth_event";
	const string DSDB_EVENT_NAME = "dsdb_event";
	const string DSDB_PWD_EVENT_NAME   = "dsdb_password_event";
	const string DSDB_GROUP_EVENT_NAME = "dsdb_group_event";
}
