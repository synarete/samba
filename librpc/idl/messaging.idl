#include "idl_types.h"

import "server_id.idl";

/*
   IDL structures for messaging code
*/

[
  pointer_default(unique)
]
interface messaging
{
	const int MSG_TYPE_MASK = 0xFFFF;

	typedef [v1_enum,public] enum {

		/* general messages */
		MSG_DEBUG			= 0x0001,
		MSG_DEBUG_V1			= 0x1001,
		MSG_PING			= 0x0002,
		MSG_PING_V1			= 0x1002,
		MSG_PONG			= 0x0003,
		MSG_PONG_V1			= 0x1003,
		MSG_PROFILE			= 0x0004,
		MSG_PROFILE_V1			= 0x1004,
		MSG_REQ_DEBUGLEVEL		= 0x0005,
		MSG_REQ_DEBUGLEVEL_V1		= 0x1005,
		MSG_DEBUGLEVEL			= 0x0006,
		MSG_DEBUGLEVEL_V1		= 0x1006,
		MSG_REQ_PROFILELEVEL		= 0x0007,
		MSG_REQ_PROFILELEVEL_V1		= 0x1007,
		MSG_PROFILELEVEL		= 0x0008,
		MSG_PROFILELEVEL_V1		= 0x1008,
		MSG_REQ_POOL_USAGE		= 0x0009,
		MSG_REQ_POOL_USAGE_V1		= 0x1009,
		/* MSG_POOL_USAGE		= 0x000A,  Obsoleted */

		/* If dmalloc is included, set a steady-state mark */
		MSG_REQ_DMALLOC_MARK		= 0x000B,
		MSG_REQ_DMALLOC_MARK_V1		= 0x100B,

		/* If dmalloc is included, dump to the dmalloc log a description of
		 * what has changed since the last MARK */
		MSG_REQ_DMALLOC_LOG_CHANGED	= 0x000C,
		MSG_REQ_DMALLOC_LOG_CHANGED_V1	= 0x100C,
		MSG_SHUTDOWN			= 0x000D,
		MSG_SHUTDOWN_V1			= 0x100D,

		/* ID_CACHE_FLUSH		= 0x000E,  Obsoleted */
		ID_CACHE_DELETE			= 0x000F,
		ID_CACHE_DELETE_V1		= 0x100F,
		ID_CACHE_KILL			= 0x0010,
		ID_CACHE_KILL_V1		= 0x1010,

		/* Changes to smb.conf are really of general interest */
		MSG_SMB_CONF_UPDATED		= 0x0021,
		MSG_SMB_CONF_UPDATED_V1		= 0x1021,
		MSG_RELOAD_TLS_CERTIFICATES	= 0x0022,
		MSG_RELOAD_TLS_CERTIFICATES_V1	= 0x1022,

		/* MSG_PREFORK_CHILD_EVENT	= 0x0031,  Obsoleted */
		/* MSG_PREFORK_PARENT_EVENT	= 0x0032,  Obsoleted */

		MSG_REQ_RINGBUF_LOG		= 0x0033,
		MSG_REQ_RINGBUF_LOG_V1		= 0x1033,
		MSG_RINGBUF_LOG			= 0x0034,
		MSG_RINGBUF_LOG_V1		= 0x1034,

		MSG_DAEMON_READY_FD             = 0x0035,
		MSG_DAEMON_READY_FD_V1          = 0x1035,

		/* This sends an empty message */
		MSG_CLUSTER_LEVEL_UPGRADED	= 0x0040,

		/* nmbd messages */
		MSG_FORCE_ELECTION		= 0x0101,
		MSG_FORCE_ELECTION_V1		= 0x1101,
		MSG_WINS_NEW_ENTRY		= 0x0102,
		MSG_SEND_PACKET			= 0x0103,

		/* printing messages */
		/* MSG_PRINTER_NOTIFY		= 0x2001,  Obsoleted */
		MSG_PRINTER_NOTIFY2		= 0x0202,
		MSG_PRINTER_DRVUPGRADE		= 0x0203,
		/* MSG_PRINTERDATA_INIT_RESET	= 0x0204,  Obsoleted */
		MSG_PRINTER_UPDATE		= 0x0205,
		/* MSG_PRINTER_MOD		= 0x0206,  Obsoleted */
		MSG_PRINTER_PCAP		= 0x0207,

		/* smbd messages */
		/* MSG_SMB_CONF_UPDATED		= 0x0301,  Obsoleted */
		MSG_SMB_FORCE_TDIS		= 0x0302,
		MSG_SMB_FORCE_TDIS_V1		= 0x1302,
		/* MSG_SMB_SAM_SYNC		= 0x0303,  Obsoleted */
		/* MSG_SMB_SAM_REPL		= 0x0304,  Obsoleted */
		/* MSG_SMB_UNLOCK		= 0x0305,  Obsoleted */
		MSG_SMB_BREAK_REQUEST		= 0x0306,
		/* MSG_SMB_BREAK_RESPONSE	= 0x0307,  Obsoleted */
		/* MSG_SMB_ASYNC_LEVEL2_BREAK	= 0x0308,  Obsoleted */
		/* MSG_SMB_OPEN_RETRY		= 0x0309,  Obsoleted */
		MSG_SMB_KERNEL_BREAK		= 0x030A,
		MSG_SMB_FILE_RENAME		= 0x030B,
		MSG_SMB_INJECT_FAULT		= 0x030C,
		/* MSG_SMB_BLOCKING_LOCK_CANCEL	= 0x030D,  Obsoleted */
		MSG_SMB_NOTIFY			= 0x030E,
		/* MSG_SMB_STAT_CACHE_DELETE	= 0x030F,  Obsoleted */

		/* Samba4 compatibility */
		MSG_PVFS_NOTIFY			= 0x0310,

		/* cluster reconfigure events */
		/* MSG_SMB_BRL_VALIDATE		= 0x0311,  Obsoleted */

		/*Close a specific file given a share entry. */
		MSG_SMB_CLOSE_FILE		= 0x0313,

		/* Trigger a notify cleanup run */
		MSG_SMB_NOTIFY_CLEANUP		= 0x0314,
		MSG_SMB_SCAVENGER		= 0x0315,

		/* shutdown connection for given client */
		MSG_SMB_KILL_CLIENT_IP		= 0x0316,
		MSG_SMB_KILL_CLIENT_IP_V1	= 0x1316,

		/* Tell number of child processes */
		MSG_SMB_TELL_NUM_CHILDREN       = 0x0317,
		MSG_SMB_NUM_CHILDREN            = 0x0318,

		/* Cancel a notify, directory got deleted */
		MSG_SMB_NOTIFY_CANCEL_DELETED   = 0x0319,

		/* notifyd messages */
		MSG_SMB_NOTIFY_REC_CHANGE	= 0x031A,
		MSG_SMB_NOTIFY_TRIGGER		= 0x031B,
		MSG_SMB_NOTIFY_GET_DB		= 0x031C,
		MSG_SMB_NOTIFY_DB		= 0x031D,
		MSG_SMB_NOTIFY_REC_CHANGES	= 0x031E,
		MSG_SMB_NOTIFY_STARTED          = 0x031F,
		MSG_SMB_SLEEP			= 0x0320,

		/* smbd message */
		MSG_SMB_FORCE_TDIS_DENIED	= 0x0321,
		MSG_SMB_FORCE_TDIS_DENIED_V1	= 0x1321,

		/* smbd ip dropped message */
		MSG_SMB_IP_DROPPED		= 0x0322,
		MSG_SMB_IP_DROPPED_V1		= 0x1322,

		/* winbind messages */
		/* MSG_WINBIND_FINISHED		= 0x0401,  Obsoleted */
		/* MSG_WINBIND_FORGET_STATE	= 0x0402,  Obsoleted */
		MSG_WINBIND_ONLINE		= 0x0403,
		MSG_WINBIND_OFFLINE		= 0x0404,
		MSG_WINBIND_ONLINESTATUS	= 0x0405,

		MSG_WINBIND_VALIDATE_CACHE	= 0x0408,
		MSG_WINBIND_DUMP_DOMAIN_LIST	= 0x0409,
		MSG_WINBIND_IP_DROPPED		= 0x040A,
		MSG_WINBIND_DOMAIN_ONLINE	= 0x040B,
		MSG_WINBIND_DOMAIN_OFFLINE	= 0x040C,
		MSG_WINBIND_RELOAD_TRUSTED_DOMAINS = 0x040D,
		MSG_WINBIND_DISCONNECT_DC       = 0x040E,

		/* event messages */
		/* MSG_DUMP_EVENT_LIST		= 0x0500,  Obsoleted */

		/* smbXsrv messages */
		MSG_SMBXSRV_SESSION_CLOSE	= 0x0600,
		MSG_SMBXSRV_CONNECTION_PASS	= 0x0601,
		MSG_SMBXSRV_CONNECTION_PASSED	= 0x0602,
		MSG_SMBXSRV_CONNECTION_DROP	= 0x0603,

		/* rpcd_witness messages */
		MSG_RPCD_WITNESS_REGISTRATION_UPDATE = 0x0680,

		/* source4 and NTVFS smb server messages */
		MSG_BRL_RETRY                   = 0x0700,
		MSG_PVFS_RETRY_OPEN             = 0x0701,
		MSG_IRPC                        = 0x0702,
		MSG_NTVFS_OPLOCK_BREAK          = 0x0703,
		MSG_DREPL_ALLOCATE_RID          = 0x0704,

		/*
		 * Audit, Authentication and Authorisation event
		 * messages
		 */
		MSG_AUTH_LOG                    = 0x0800,
		MSG_DSDB_LOG                    = 0x0801,
		MSG_DSDB_PWD_LOG                = 0x0802,
		MSG_GROUP_LOG                   = 0x0803,

		/*
		 * VFS aio_ratelimit cluster coordination messages
		 * Node-level aggregation via ratelimitd daemon
		 */
		MSG_VFS_AIO_RATELIMIT_READ_NODE_SUMMARY	= 0x0900,
		MSG_VFS_AIO_RATELIMIT_WRITE_NODE_SUMMARY = 0x0901,

		/* dbwrap messages 4001-4999 (0x0FA0 - 0x1387) */
		/* MSG_DBWRAP_TDB2_CHANGES		= 4001, */
		/* MSG_DBWRAP_G_LOCK_RETRY		= 4002, */
		MSG_DBWRAP_MODIFIED		= 4003,

		MSG_RPC_HOST_NEW_CLIENT         = 4004,
		MSG_RPC_WORKER_STATUS           = 4005,
		MSG_RPC_DUMP_STATUS             = 4006,
		MSG_RPC_WORKER_INFO             = 4007,

		/*
		 * source4 allows new messages to be registered at
		 * runtime (currently used in python bindings and in
		 * smbtorture). Temporary messaging endpoints are
		 * allocated above this line
		 */
		MSG_TMP_BASE                    = 0xF000
	} messaging_type;

	/* MSG_DEBUG */
	typedef [public, v1_enum] enum {
		MESSAGING_DEBUG_VERSION_1 = 0x00000001
	} messaging_debug_version_values;

	const uint32 MESSAGING_DEBUG_VERSION_CURRENT =
		MESSAGING_DEBUG_VERSION_1;

	typedef [public] struct {
		messaging_debug_version_values version;
		utf8string debug_string;
	} messaging_debug_v1;

	/* MSG_REQ_DEBUGLEVEL / MSG_DEBUGLEVEL */
	typedef [public, v1_enum] enum {
		MESSAGING_DEBUGLEVEL_VERSION_1 = 0x00000001
	} messaging_debuglevel_version_values;

	const uint32 MESSAGING_DEBUGLEVEL_VERSION_CURRENT =
		MESSAGING_DEBUGLEVEL_VERSION_1;

	typedef [public] struct {
		messaging_debuglevel_version_values version;
	} messaging_req_debuglevel_v1;

	typedef [public] struct {
		messaging_debuglevel_version_values version;
		utf8string debuglevel_string;
	} messaging_debuglevel_v1;

	/* MSG_PROFILE */
	typedef [public, v1_enum] enum {
		MESSAGING_PROFILE_VERSION_1 = 0x00000001
	} messaging_profile_version_values;

	const uint32 MESSAGING_PROFILE_VERSION_CURRENT =
		MESSAGING_PROFILE_VERSION_1;

	typedef [public] struct {
		messaging_profile_version_values version;
		uint32 level;
	} messaging_profile_v1;

	/* MSG_REQ_PROFILELEVEL / MSG_PROFILELEVEL */
	typedef [public, v1_enum] enum {
		MESSAGING_PROFILELEVEL_VERSION_1 = 0x00000001
	} messaging_profilelevel_version_values;

	const uint32 MESSAGING_PROFILELEVEL_VERSION_CURRENT =
		MESSAGING_PROFILELEVEL_VERSION_1;

	typedef [public] struct {
		messaging_profilelevel_version_values version;
	} messaging_req_profilelevel_v1;

	typedef [public] struct {
		messaging_profilelevel_version_values version;
		uint32 level;
	} messaging_profilelevel_v1;

	/* MSG_REQ_POOL_USAGE */
	typedef [public, v1_enum] enum {
		MESSAGING_REQ_POOL_USAGE_VERSION_1 = 0x00000001
	} messaging_req_pool_usage_version_values;

	const uint32 MESSAGING_REQ_POOL_USAGE_VERSION_CURRENT =
		MESSAGING_REQ_POOL_USAGE_VERSION_1;

	typedef [public] struct {
		messaging_req_pool_usage_version_values version;
	} messaging_req_pool_usage_v1;

	/* MSG_REQ_RINGBUF_LOG_V1 / MSG_RINGBUF_LOG_V1 */
	typedef [public, v1_enum] enum {
		MESSAGING_RINGBUF_LOG_VERSION_1 = 0x00000001
	} messaging_ringbuf_log_version_values;

	const uint32 MESSAGING_RINGBUF_LOG_VERSION_CURRENT =
		MESSAGING_RINGBUF_LOG_VERSION_1;

	typedef [public] struct {
		messaging_ringbuf_log_version_values version;
	} messaging_req_ringbuf_log_v1;

	typedef [public] struct {
		messaging_ringbuf_log_version_values version;
		utf8string log;
	} messaging_ringbuf_log_v1;

	/* MSG_RELOAD_TLS_CERTIFICATES */
	typedef [public, v1_enum] enum {
		MESSAGING_RELOAD_TLS_CERTIFICATES_VERSION_1 = 0x00000001
	} messaging_reload_tls_certificates_version_values;

	const uint32 MESSAGING_RELOAD_TLS_CERTIFICATES_VERSION_CURRENT =
		MESSAGING_RELOAD_TLS_CERTIFICATES_VERSION_1;

	typedef [public] struct {
		messaging_reload_tls_certificates_version_values version;
	} messaging_reload_tls_certificates_v1;

	/* MSG_SMB_CONF_UPDATED */
	typedef [public, v1_enum] enum {
		MESSAGING_SMB_CONF_UPDATED_VERSION_1 = 0x00000001
	} messaging_smb_conf_updated_version_values;

	const uint32 MESSAGING_SMB_CONF_UPDATED_VERSION_CURRENT =
		MESSAGING_SMB_CONF_UPDATED_VERSION_1;

	typedef [public] struct {
		messaging_smb_conf_updated_version_values version;
	} messaging_smb_conf_updated_v1;

	/* MSG_SMB_IP_DROPPED */
	typedef [public, v1_enum] enum {
		MESSAGING_SMB_IP_DROPPED_VERSION_1 = 0x00000001
	} messaging_smb_ip_dropped_version_values;

	const uint32 MESSAGING_SMB_IP_DROPPED_VERSION_CURRENT =
		MESSAGING_SMB_IP_DROPPED_VERSION_1;

	typedef [public] struct {
		messaging_smb_ip_dropped_version_values version;
		utf8string server_ip;
	} messaging_smb_ip_dropped_v1;

	/* MSG_SMB_KILL_CLIENT_IP / MSG_SMB_FORCE_TDIS / MSG_SMB_FORCE_TDIS_DENIED */
	typedef [public, v1_enum] enum {
		MESSAGING_SMB_KILL_CLIENT_IP_VERSION_1 = 0x00000001
	} messaging_smb_kill_client_ip_version_values;

	const uint32 MESSAGING_SMB_KILL_CLIENT_IP_VERSION_CURRENT =
		MESSAGING_SMB_KILL_CLIENT_IP_VERSION_1;

	typedef [public] struct {
		messaging_smb_kill_client_ip_version_values version;
		utf8string client_ip;
	} messaging_smb_kill_client_ip_v1;

	typedef [public, v1_enum] enum {
		MESSAGING_SMB_FORCE_TDIS_VERSION_1 = 0x00000001
	} messaging_smb_force_tdis_version_values;

	const uint32 MESSAGING_SMB_FORCE_TDIS_VERSION_CURRENT =
		MESSAGING_SMB_FORCE_TDIS_VERSION_1;

	typedef [public] struct {
		messaging_smb_force_tdis_version_values version;
		utf8string sharename;
	} messaging_smb_force_tdis_v1;

	typedef [public] struct {
		messaging_smb_force_tdis_version_values version;
		utf8string sharename;
	} messaging_smb_force_tdis_denied_v1;

	/* MSG_FORCE_ELECTION */
	typedef [public, v1_enum] enum {
		MESSAGING_FORCE_ELECTION_VERSION_1 = 0x00000001
	} messaging_force_election_version_values;

	const uint32 MESSAGING_FORCE_ELECTION_VERSION_CURRENT =
		MESSAGING_FORCE_ELECTION_VERSION_1;

	typedef [public] struct {
		messaging_force_election_version_values version;
	} messaging_force_election_v1;

	/* MSG_DAEMON_READY_FD */
	typedef [public, v1_enum] enum {
		MESSAGING_DAEMON_READY_FD_VERSION_1 = 0x00000001
	} messaging_daemon_ready_fd_version_values;

	const uint32 MESSAGING_DAEMON_READY_FD_VERSION_CURRENT =
		MESSAGING_DAEMON_READY_FD_VERSION_1;

	typedef [public] struct {
		messaging_daemon_ready_fd_version_values version;
	} messaging_daemon_ready_fd_v1;

	/* MSG_REQ_DMALLOC_MARK / MSG_REQ_DMALLOC_LOG_CHANGED */
	typedef [public, v1_enum] enum {
		MESSAGING_REQ_DMALLOC_VERSION_1 = 0x00000001
	} messaging_req_dmalloc_version_values;

	const uint32 MESSAGING_REQ_DMALLOC_VERSION_CURRENT =
		MESSAGING_REQ_DMALLOC_VERSION_1;

	typedef [public] struct {
		messaging_req_dmalloc_version_values version;
	} messaging_req_dmalloc_mark_v1;

	typedef [public] struct {
		messaging_req_dmalloc_version_values version;
	} messaging_req_dmalloc_log_changed_v1;

	/* MSG_PING / MSG_PONG */
	typedef [public, v1_enum] enum {
		MESSAGING_PING_VERSION_1 = 0x00000001
	} messaging_ping_version_values;

	const uint32 MESSAGING_PING_VERSION_CURRENT =
		MESSAGING_PING_VERSION_1;

	typedef [public] struct {
		messaging_ping_version_values version;
		utf8string payload;
	} messaging_ping_v1;

	typedef [public] struct {
		messaging_ping_version_values version;
	} messaging_pong_v1;

	/* MSG_SHUTDOWN */
	typedef [public, v1_enum] enum {
		MESSAGING_SHUTDOWN_VERSION_1 = 0x00000001
	} messaging_shutdown_version_values;

	const uint32 MESSAGING_SHUTDOWN_VERSION_CURRENT =
		MESSAGING_SHUTDOWN_VERSION_1;

	typedef [public] struct {
		messaging_shutdown_version_values version;
	} messaging_shutdown_v1;

	/* ID_CACHE_DELETE / ID_CACHE_KILL */
	typedef [public, v1_enum] enum {
		MESSAGING_ID_CACHE_VERSION_1 = 0x00000001
	} messaging_id_cache_version_values;

	const uint32 MESSAGING_ID_CACHE_VERSION_CURRENT =
		MESSAGING_ID_CACHE_VERSION_1;

	typedef [public] struct {
		messaging_id_cache_version_values version;
		utf8string id;
	} messaging_id_cache_delete_v1;

	typedef [public] struct {
		messaging_id_cache_version_values version;
		utf8string id;
	} messaging_id_cache_kill_v1;

	/* messaging struct sent across the sockets and stored in the tdb */

	typedef [public] struct {
		[skip] messaging_rec *prev;
		[skip] messaging_rec *next;
		uint32 msg_version;
		messaging_type msg_type;
		server_id dest;
		server_id src;
		DATA_BLOB buf;
		uint8 num_fds;
		dlong fds[num_fds];
	} messaging_rec;

	typedef [public] struct {
		hyper rec_index;
		uint32 num_recs;
		messaging_rec *recs[num_recs];
	} messaging_reclog;

        /* This allows this well known service name to be referenced in python and C */
        const string AUTH_EVENT_NAME  = "auth_event";
	const string DSDB_EVENT_NAME = "dsdb_event";
	const string DSDB_PWD_EVENT_NAME   = "dsdb_password_event";
	const string DSDB_GROUP_EVENT_NAME = "dsdb_group_event";
}
