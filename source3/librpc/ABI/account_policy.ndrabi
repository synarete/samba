# NDR wire format ABI of account_policy.idl
#
# This is the output of ndr_abi_account_policy (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root account_policy_value_rec
root account_policy_privileges_rec

[flag(LIBNDR_FLAG_NOALIGN)] struct account_policy_privileges_rec align(8) {
	scalar:hyper	# privileges
}

[flag(LIBNDR_FLAG_NOALIGN)] struct account_policy_value_rec align(4) {
	scalar:uint32	# value
}

sample account_policy_value_rec length(4) {
	[0000] 01 02 03 04
}
#	    account_policy_value_rec: struct account_policy_value_rec
#	        value                    : 0x04030201 (67305985)

sample account_policy_privileges_rec length(8) {
	[0000] 01 02 03 04 05 06 07 08
}
#	    account_policy_privileges_rec: struct account_policy_privileges_rec
#	        privileges               : 0x0807060504030201 (578437695752307201)

