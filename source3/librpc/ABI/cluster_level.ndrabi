# NDR wire format ABI of cluster_level.idl
#
# This is the output of ndr_abi_cluster_level (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root cluster_level_globalB
root cluster_level_nodeB

struct cluster_level_active align(4) {
	scalar:uint32	# major
	scalar:uint32	# minor
}

enum cluster_level_db_version base(uint32) {
	0x00000001	# CLUSTER_LEVEL_DB_VERSION_1
}

struct cluster_level_global1 align(4) {
	external:timeval	# update_time
	struct:cluster_level_active	# active_level
}

struct cluster_level_globalB align(4) {
	enum:cluster_level_db_version	# version
	switch(version) union:cluster_level_globalU	# info
}

union cluster_level_globalU align(4) switch_type(scalar:uint32) {
	case(CLUSTER_LEVEL_DB_VERSION_1): struct:cluster_level_global1	# info1
	default: EMPTY
}

struct cluster_level_node1 align(4) {
	external:timeval	# update_time
	external:timeval	# ctdbd_start_time
	scalar:uint32	# ctdbd_pid
	struct:cluster_level_ranges	# supported_ranges
}

struct cluster_level_nodeB align(4) {
	enum:cluster_level_db_version	# version
	switch(version) union:cluster_level_nodeU	# info
}

union cluster_level_nodeU align(4) switch_type(scalar:uint32) {
	case(CLUSTER_LEVEL_DB_VERSION_1): struct:cluster_level_node1	# info1
	default: EMPTY
}

struct cluster_level_range align(4) {
	scalar:uint32	# major
	scalar:uint32	# minor_min
	scalar:uint32	# minor_max
}

struct cluster_level_ranges align(4) {
	[range(1,256)] scalar:uint32	# num_ranges
	array(inline=num_ranges) struct:cluster_level_range	# ranges
}

external timeval

sample cluster_level_globalB length(28) {
	[0000] 01 00 00 00 01 00 00 00  01 02 03 04 00 00 00 00
	[0010] 02 46 02 00 03 04 05 06  04 05 06 07
}
