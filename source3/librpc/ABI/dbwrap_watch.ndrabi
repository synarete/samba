# NDR wire format ABI of dbwrap_watch.idl
#
# This is the output of ndr_abi_dbwrap_watch (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root dbwrap_watcher_rec
root dbwrap_watch_rec

[flag(LIBNDR_FLAG_NOALIGN)] struct dbwrap_watch_rec align(8) {
	scalar:uint32	# num_watchers
	array(inline=num_watchers) struct:dbwrap_watcher_rec	# watchers
	[flag(LIBNDR_FLAG_REMAINING)] scalar:DATA_BLOB	# data
}

[flag(LIBNDR_FLAG_NOALIGN)] struct dbwrap_watcher_rec align(8) {
	struct:server_id	# pid
	scalar:hyper	# instance
}

struct server_id align(8) {
	scalar:hyper	# pid
	scalar:uint32	# task_id
	scalar:uint32	# vnn
	scalar:hyper	# unique_id
}

sample dbwrap_watcher_rec length(32) {
	[0000] 01 02 03 04 05 06 07 08  02 03 04 05 03 04 05 06
	[0010] 04 05 06 07 08 09 0a 0b  05 06 07 08 09 0a 0b 0c
}
#	    dbwrap_watcher_rec: struct dbwrap_watcher_rec
#	        pid: struct server_id
#	            pid                      : 0x0807060504030201 (578437695752307201)
#	            task_id                  : 0x05040302 (84148994)
#	            vnn                      : 0x06050403 (100992003)
#	            unique_id                : 0x0b0a090807060504 (795458214266537220)
#	        instance                 : 0x0c0b0a0908070605 (867798387104613893)

