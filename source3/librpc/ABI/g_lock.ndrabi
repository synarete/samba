# NDR wire format ABI of g_lock.idl
#
# This is the output of ndr_abi_g_lock (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root g_lock_rec

[flag(LIBNDR_FLAG_NOALIGN)] struct g_lock_rec align(8) {
	struct:server_id	# exclusive
	scalar:hyper	# unique_lock_epoch
	scalar:hyper	# unique_data_epoch
	scalar:uint32	# num_shared
	array(inline=num_shared) struct:server_id	# shared
	[flag(LIBNDR_FLAG_REMAINING)] scalar:DATA_BLOB	# data
}

struct server_id align(8) {
	scalar:hyper	# pid
	scalar:uint32	# task_id
	scalar:uint32	# vnn
	scalar:hyper	# unique_id
}

sample g_lock_rec length(96) {
	[0000] 01 02 03 04 05 06 07 08  02 03 04 05 03 04 05 06
	[0010] 04 05 06 07 08 09 0a 0b  05 06 07 08 09 0a 0b 0c
	[0020] 06 07 08 09 0a 0b 0c 0d  02 00 00 00 07 08 09 0a
	[0030] 0b 0c 0d 0e 08 09 0a 0b  09 0a 0b 0c 0a 0b 0c 0d
	[0040] 0e 0f 10 11 0b 0c 0d 0e  0f 10 11 12 0c 0d 0e 0f
	[0050] 0d 0e 0f 10 0e 0f 10 11  12 13 14 15 0f 11 13 15
}
#	    g_lock_rec: struct g_lock_rec
#	        exclusive: struct server_id
#	            pid                      : 0x0807060504030201 (578437695752307201)
#	            task_id                  : 0x05040302 (84148994)
#	            vnn                      : 0x06050403 (100992003)
#	            unique_id                : 0x0b0a090807060504 (795458214266537220)
#	        unique_lock_epoch        : 0x0c0b0a0908070605 (867798387104613893)
#	        unique_data_epoch        : 0x0d0c0b0a09080706 (940138559942690566)
#	        num_shared               : 0x00000002 (2)
#	        shared: ARRAY(2)
#	            shared: struct server_id
#	                pid                      : 0x0e0d0c0b0a090807 (1012478732780767239)
#	                task_id                  : 0x0b0a0908 (185207048)
#	                vnn                      : 0x0c0b0a09 (202050057)
#	                unique_id                : 0x11100f0e0d0c0b0a (1229499251294997258)
#	            shared: struct server_id
#	                pid                      : 0x1211100f0e0d0c0b (1301839424133073931)
#	                task_id                  : 0x0f0e0d0c (252579084)
#	                vnn                      : 0x100f0e0d (269422093)
#	                unique_id                : 0x1514131211100f0e (1518859942647303950)
#	        data                     : DATA_BLOB length=4
#	[0000] 0F 11 13 15                                         ....

sample g_lock_rec@minimal length(48) {
	[0000] 01 02 03 04 05 06 07 08  02 03 04 05 03 04 05 06
	[0010] 04 05 06 07 08 09 0a 0b  05 06 07 08 09 0a 0b 0c
	[0020] 06 07 08 09 0a 0b 0c 0d  00 00 00 00 07 09 0b 0d
}
