# NDR wire format ABI of group_mapping.idl
#
# This is the output of ndr_abi_group_mapping (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root group_mapping_rec
root group_mapping_memberof_rec

[flag(LIBNDR_FLAG_NOALIGN)] struct group_mapping_memberof_rec align(4) {
	[flag(LIBNDR_FLAG_STR_RAW8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# aliases
}

[flag(LIBNDR_FLAG_NOALIGN)] struct group_mapping_rec align(4) {
	scalar:uint32	# gid
	scalar:uint32	# sid_name_use
	[flag(LIBNDR_FLAG_STR_RAW8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# nt_name
	[flag(LIBNDR_FLAG_STR_RAW8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# comment
}

sample group_mapping_rec length(38) {
	[0000] 01 02 03 04 02 03 04 05  73 74 72 69 6e 67 30 30
	[0010] 30 30 30 30 30 33 00 73  74 72 69 6e 67 30 30 30
	[0020] 30 30 30 30 34 00
}
#	    group_mapping_rec: struct group_mapping_rec
#	        gid                      : 0x04030201 (67305985)
#	        sid_name_use             : 0x05040302 (84148994)
#	        nt_name                  : 'string00000003'
#	        comment                  : 'string00000004'

sample group_mapping_memberof_rec length(15) {
	[0000] 73 74 72 69 6e 67 30 30  30 30 30 30 30 31 00
}
#	    group_mapping_memberof_rec: struct group_mapping_memberof_rec
#	        aliases                  : 'string00000001'

