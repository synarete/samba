# NDR wire format ABI of idmap_tdb.idl
#
# This is the output of ndr_abi_idmap_tdb (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root idmap_tdb_uint32_rec
root idmap_tdb_string_rec
root idmap_autorid_config_rec

[flag(LIBNDR_FLAG_NOALIGN)] struct idmap_autorid_config_rec align(4) {
	[flag(LIBNDR_FLAG_STR_RAW8|LIBNDR_FLAG_STR_NOTERM|LIBNDR_FLAG_REMAINING)] scalar:string	# config
}

[flag(LIBNDR_FLAG_NOALIGN)] struct idmap_tdb_string_rec align(4) {
	[flag(LIBNDR_FLAG_STR_RAW8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# str
}

[flag(LIBNDR_FLAG_NOALIGN)] struct idmap_tdb_uint32_rec align(4) {
	scalar:uint32	# value
}

sample idmap_tdb_uint32_rec length(4) {
	[0000] 01 02 03 04
}
#	    idmap_tdb_uint32_rec: struct idmap_tdb_uint32_rec
#	        value                    : 0x04030201 (67305985)

sample idmap_tdb_string_rec length(15) {
	[0000] 73 74 72 69 6e 67 30 30  30 30 30 30 30 31 00
}
#	    idmap_tdb_string_rec: struct idmap_tdb_string_rec
#	        str                      : 'string00000001'

sample idmap_autorid_config_rec length(14) {
	[0000] 73 74 72 69 6e 67 30 30  30 30 30 30 30 31
}
#	    idmap_autorid_config_rec: struct idmap_autorid_config_rec
#	        config                   : 'string00000001'

