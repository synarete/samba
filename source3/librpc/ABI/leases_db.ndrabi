# NDR wire format ABI of leases_db.idl
#
# This is the output of ndr_abi_leases_db (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root leases_db_key
root leases_db_file
root leases_db_value

struct GUID align(4) {
	scalar:uint32	# time_low
	scalar:uint16	# time_mid
	scalar:uint16	# time_hi_and_version
	array(fixed=2) scalar:uint8	# clock_seq
	array(fixed=6) scalar:uint8	# node
}

struct file_id align(4) {
	scalar:udlong	# devid
	scalar:udlong	# inode
	scalar:udlong	# extid
}

struct leases_db_file align(5) {
	struct:file_id	# id
	[charset(UTF8)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint8	# servicepath
	[charset(UTF8)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint8	# base_name
	[charset(UTF8)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint8	# stream_name
}

struct leases_db_key align(8) {
	struct:GUID	# client_guid
	struct:smb2_lease_key	# lease_key
}

struct leases_db_value align(5) {
	bitmap:smb2_lease_state	# current_state
	scalar:uint8	# breaking
	bitmap:smb2_lease_state	# breaking_to_requested
	bitmap:smb2_lease_state	# breaking_to_required
	scalar:uint16	# lease_version
	scalar:uint16	# epoch
	scalar:uint32	# num_files
	array(inline=num_files) struct:leases_db_file	# files
}

struct smb2_lease_key align(8) {
	array(fixed=2) scalar:hyper	# data
}

bitmap smb2_lease_state base(uint32) {
	0	# SMB2_LEASE_READ ( 0x01 )
	1	# SMB2_LEASE_HANDLE ( 0x02 )
	2	# SMB2_LEASE_WRITE ( 0x04 )
}

sample leases_db_key length(32) {
	[0000] 01 02 03 04 02 03 03 04  04 05 06 07 08 09 0a 0b
	[0010] 0c 0d 0e 0f 10 11 12 13  0d 0e 0f 10 11 12 13 14
}
#	    leases_db_key: struct leases_db_key
#	        client_guid              : 04030201-0302-0403-0405-060708090a0b
#	        lease_key: struct smb2_lease_key
#	            data: ARRAY(2)
#	                data                     : 0x131211100f0e0d0c (1374179596971150604)
#	                data                     : 0x14131211100f0e0d (1446519769809227277)

