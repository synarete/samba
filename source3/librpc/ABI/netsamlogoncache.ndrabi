# NDR wire format ABI of netsamlogoncache.idl
#
# This is the output of ndr_abi_netsamlogoncache (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root netsamlogoncache_entry

external dom_sid2

struct lsa_String align(5) {
	[value(2*strlen_m(string))] scalar:uint16	# length
	[value(2*strlen_m(string))] scalar:uint16	# size
	[charset(UTF16)] ptr(unique) array(conformant=size/2,varying=length/2) scalar:uint16	# string
}

struct lsa_StringLarge align(5) {
	[value(2*strlen_m(string))] scalar:uint16	# length
	[value(2*strlen_m_term(string))] scalar:uint16	# size
	[charset(UTF16)] ptr(unique) array(conformant=size/2,varying=length/2) scalar:uint16	# string
}

[flag(LIBNDR_PRINT_ARRAY_HEX)] struct netr_LMSessionKey align(1) {
	[flag(LIBNDR_FLAG_IS_SECRET)] array(fixed=8) scalar:uint8	# key
}

struct netr_SamBaseInfo align(5) {
	scalar:NTTIME	# logon_time
	scalar:NTTIME	# logoff_time
	scalar:NTTIME	# kickoff_time
	scalar:NTTIME	# last_password_change
	scalar:NTTIME	# allow_password_change
	scalar:NTTIME	# force_password_change
	struct:lsa_String	# account_name
	struct:lsa_String	# full_name
	struct:lsa_String	# logon_script
	struct:lsa_String	# profile_path
	struct:lsa_String	# home_directory
	struct:lsa_String	# home_drive
	scalar:uint16	# logon_count
	scalar:uint16	# bad_password_count
	scalar:uint32	# rid
	scalar:uint32	# primary_gid
	struct:samr_RidWithAttributeArray	# groups
	bitmap:netr_UserFlags	# user_flags
	struct:netr_UserSessionKey	# key
	struct:lsa_StringLarge	# logon_server
	struct:lsa_StringLarge	# logon_domain
	ptr(unique) external:dom_sid2	# domain_sid
	struct:netr_LMSessionKey	# LMSessKey
	bitmap:samr_AcctFlags	# acct_flags
	scalar:uint32	# sub_auth_status
	scalar:NTTIME	# last_successful_logon
	scalar:NTTIME	# last_failed_logon
	scalar:uint32	# failed_logon_count
	scalar:uint32	# reserved
}

struct netr_SamInfo3 align(5) {
	struct:netr_SamBaseInfo	# base
	scalar:uint32	# sidcount
	ptr(unique) array(conformant=sidcount) struct:netr_SidAttr	# sids
}

struct netr_SidAttr align(5) {
	ptr(unique) external:dom_sid2	# sid
	bitmap:security_GroupAttrs	# attributes
}

bitmap netr_UserFlags base(uint32) {
	0	# NETLOGON_GUEST ( 0x00000001 )
	1	# NETLOGON_NOENCRYPTION ( 0x00000002 )
	2	# NETLOGON_CACHED_ACCOUNT ( 0x00000004 )
	3	# NETLOGON_USED_LM_PASSWORD ( 0x00000008 )
	4	# NETLOGON_EXTRA_SIDS ( 0x00000020 )
	5	# NETLOGON_SUBAUTH_SESSION_KEY ( 0x00000040 )
	6	# NETLOGON_SERVER_TRUST_ACCOUNT ( 0x00000080 )
	7	# NETLOGON_NTLMV2_ENABLED ( 0x00000100 )
	8	# NETLOGON_RESOURCE_GROUPS ( 0x00000200 )
	9	# NETLOGON_PROFILE_PATH_RETURNED ( 0x00000400 )
	10	# NETLOGON_GRACE_LOGON ( 0x01000000 )
}

[flag(LIBNDR_PRINT_ARRAY_HEX)] struct netr_UserSessionKey align(1) {
	[flag(LIBNDR_FLAG_IS_SECRET)] array(fixed=16) scalar:uint8	# key
}

struct netsamlogoncache_entry align(5) {
	scalar:time_t	# timestamp
	struct:netr_SamInfo3	# info3
}

bitmap samr_AcctFlags base(uint32) {
	0	# ACB_DISABLED ( 0x00000001 )
	1	# ACB_HOMDIRREQ ( 0x00000002 )
	2	# ACB_PWNOTREQ ( 0x00000004 )
	3	# ACB_TEMPDUP ( 0x00000008 )
	4	# ACB_NORMAL ( 0x00000010 )
	5	# ACB_MNS ( 0x00000020 )
	6	# ACB_DOMTRUST ( 0x00000040 )
	7	# ACB_WSTRUST ( 0x00000080 )
	8	# ACB_SVRTRUST ( 0x00000100 )
	9	# ACB_PWNOEXP ( 0x00000200 )
	10	# ACB_AUTOLOCK ( 0x00000400 )
	11	# ACB_ENC_TXT_PWD_ALLOWED ( 0x00000800 )
	12	# ACB_SMARTCARD_REQUIRED ( 0x00001000 )
	13	# ACB_TRUSTED_FOR_DELEGATION ( 0x00002000 )
	14	# ACB_NOT_DELEGATED ( 0x00004000 )
	15	# ACB_USE_DES_KEY_ONLY ( 0x00008000 )
	16	# ACB_DONT_REQUIRE_PREAUTH ( 0x00010000 )
	17	# ACB_PW_EXPIRED ( 0x00020000 )
	18	# ACB_TRUSTED_TO_AUTHENTICATE_FOR_DELEGATION ( 0x00040000 )
	19	# ACB_NO_AUTH_DATA_REQD ( 0x00080000 )
	20	# ACB_PARTIAL_SECRETS_ACCOUNT ( 0x00100000 )
	21	# ACB_USE_AES_KEYS ( 0x00200000 )
}

struct samr_RidWithAttribute align(4) {
	scalar:uint32	# rid
	bitmap:security_GroupAttrs	# attributes
}

struct samr_RidWithAttributeArray align(5) {
	scalar:uint32	# count
	ptr(unique) array(conformant=count) struct:samr_RidWithAttribute	# rids
}

bitmap security_GroupAttrs base(uint32) {
	0	# SE_GROUP_MANDATORY ( 0x00000001 )
	1	# SE_GROUP_ENABLED_BY_DEFAULT ( 0x00000002 )
	2	# SE_GROUP_ENABLED ( 0x00000004 )
	3	# SE_GROUP_OWNER ( 0x00000008 )
	4	# SE_GROUP_USE_FOR_DENY_ONLY ( 0x00000010 )
	5	# SE_GROUP_INTEGRITY ( 0x00000020 )
	6	# SE_GROUP_INTEGRITY_ENABLED ( 0x00000040 )
	7	# SE_GROUP_RESOURCE ( 0x20000000 )
	8	# SE_GROUP_LOGON_ID ( 0xC0000000 )
}

