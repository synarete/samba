# NDR wire format ABI of printer_list.idl
#
# This is the output of ndr_abi_printer_list (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root printer_list_printer_rec
root printer_list_last_refresh_rec

[flag(LIBNDR_FLAG_NOALIGN)] struct printer_list_last_refresh_rec align(4) {
	scalar:uint32	# refresh_high
	scalar:uint32	# refresh_low
}

[flag(LIBNDR_FLAG_NOALIGN)] struct printer_list_printer_rec align(4) {
	scalar:uint32	# refresh_high
	scalar:uint32	# refresh_low
	[flag(LIBNDR_FLAG_STR_RAW8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# name
	[flag(LIBNDR_FLAG_STR_RAW8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# comment
	[flag(LIBNDR_FLAG_STR_RAW8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# location
}

sample printer_list_printer_rec length(53) {
	[0000] 01 02 03 04 02 03 04 05  73 74 72 69 6e 67 30 30
	[0010] 30 30 30 30 30 33 00 73  74 72 69 6e 67 30 30 30
	[0020] 30 30 30 30 34 00 73 74  72 69 6e 67 30 30 30 30
	[0030] 30 30 30 35 00
}
#	    printer_list_printer_rec: struct printer_list_printer_rec
#	        refresh_high             : 0x04030201 (67305985)
#	        refresh_low              : 0x05040302 (84148994)
#	        name                     : 'string00000003'
#	        comment                  : 'string00000004'
#	        location                 : 'string00000005'

sample printer_list_last_refresh_rec length(8) {
	[0000] 01 02 03 04 02 03 04 05
}
#	    printer_list_last_refresh_rec: struct printer_list_last_refresh_rec
#	        refresh_high             : 0x04030201 (67305985)
#	        refresh_low              : 0x05040302 (84148994)

