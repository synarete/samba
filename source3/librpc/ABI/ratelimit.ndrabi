# NDR wire format ABI of ratelimit.idl
#
# This is the output of ndr_abi_ratelimit (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root ratelimit_activity_report
root ratelimit_node_summary
root ratelimit_tdb_record

[flag(LIBNDR_FLAG_NOALIGN)] struct ratelimit_activity_report align(8) {
	scalar:hyper	# timestamp_usec
	scalar:int64	# recent_iops
	scalar:uint32	# protocol_version
	scalar:uint32	# operation
	scalar:int32	# pid
	scalar:uint32	# inflight_ios
	[charset(UTF8)] array(fixed=256) scalar:uint8	# share_name
}

[flag(LIBNDR_FLAG_NOALIGN)] struct ratelimit_node_summary align(8) {
	scalar:uint32	# vnn
	scalar:int32	# process_count
	scalar:hyper	# timestamp_usec
	[charset(UTF8)] array(fixed=256) scalar:uint8	# share_name
}

[flag(LIBNDR_FLAG_NOALIGN)] struct ratelimit_tdb_record align(8) {
	scalar:hyper	# last_usec
	scalar:float	# iops_tokens
	scalar:float	# bytes_tokens
	array(fixed=48) scalar:uint8	# reserved
}

