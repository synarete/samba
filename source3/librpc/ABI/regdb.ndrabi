# NDR wire format ABI of regdb.idl
#
# This is the output of ndr_abi_regdb (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root regdb_version_rec
root regdb_subkey_list
root regdb_value_list

[flag(LIBNDR_FLAG_NOALIGN)] struct regdb_subkey align(4) {
	[flag(LIBNDR_FLAG_STR_RAW8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# name
}

[flag(LIBNDR_FLAG_NOALIGN)] struct regdb_subkey_list align(4) {
	scalar:uint32	# num_subkeys
	array(inline=num_subkeys) struct:regdb_subkey	# subkeys
}

[flag(LIBNDR_FLAG_NOALIGN)] struct regdb_value align(4) {
	[flag(LIBNDR_FLAG_STR_RAW8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# name
	scalar:uint32	# type
	scalar:uint32	# size
	array(inline=size) scalar:uint8	# data
}

[flag(LIBNDR_FLAG_NOALIGN)] struct regdb_value_list align(4) {
	scalar:uint32	# num_values
	array(inline=num_values) struct:regdb_value	# values
}

[flag(LIBNDR_FLAG_NOALIGN)] struct regdb_version_rec align(4) {
	scalar:int32	# version
}

sample regdb_version_rec length(4) {
	[0000] 01 02 03 04
}
#	    regdb_version_rec: struct regdb_version_rec
#	        version                  : 67305985

sample regdb_subkey_list length(34) {
	[0000] 02 00 00 00 73 74 72 69  6e 67 30 30 30 30 30 30
	[0010] 30 31 00 73 74 72 69 6e  67 30 30 30 30 30 30 30
	[0020] 32 00
}
#	    regdb_subkey_list: struct regdb_subkey_list
#	        num_subkeys              : 0x00000002 (2)
#	        subkeys: ARRAY(2)
#	            subkeys: struct regdb_subkey
#	                name                     : 'string00000001'
#	            subkeys: struct regdb_subkey
#	                name                     : 'string00000002'

sample regdb_subkey_list@minimal length(4) {
	[0000] 00 00 00 00
}
#	    regdb_subkey_list: struct regdb_subkey_list
#	        num_subkeys              : 0x00000000 (0)
#	        subkeys: ARRAY(0)

sample regdb_value_list length(54) {
	[0000] 02 00 00 00 73 74 72 69  6e 67 30 30 30 30 30 30
	[0010] 30 31 00 02 03 04 05 02  00 00 00 03 04 73 74 72
	[0020] 69 6e 67 30 30 30 30 30  30 30 35 00 06 07 08 09
	[0030] 02 00 00 00 07 08
}
#	    regdb_value_list: struct regdb_value_list
#	        num_values               : 0x00000002 (2)
#	        values: ARRAY(2)
#	            values: struct regdb_value
#	                name                     : 'string00000001'
#	                type                     : 0x05040302 (84148994)
#	                size                     : 0x00000002 (2)
#	                data: ARRAY(2)
#	                    [0]                      : 0x03 (3)
#	                    [1]                      : 0x04 (4)
#	            values: struct regdb_value
#	                name                     : 'string00000005'
#	                type                     : 0x09080706 (151521030)
#	                size                     : 0x00000002 (2)
#	                data: ARRAY(2)
#	                    [0]                      : 0x07 (7)
#	                    [1]                      : 0x08 (8)

sample regdb_value_list@minimal length(4) {
	[0000] 00 00 00 00
}
#	    regdb_value_list: struct regdb_value_list
#	        num_values               : 0x00000000 (0)
#	        values: ARRAY(0)

