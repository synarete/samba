# NDR wire format ABI of rpcd_witness.idl
#
# This is the output of ndr_abi_rpcd_witness (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root rpcd_witness_registration
root rpcd_witness_registration_updateB

struct GUID align(4) {
	scalar:uint32	# time_low
	scalar:uint16	# time_mid
	scalar:uint16	# time_hi_and_version
	array(fixed=2) scalar:uint8	# clock_seq
	array(fixed=6) scalar:uint8	# node
}

[nopull,nopush] struct dom_sid align(4) {
	scalar:uint8	# sid_rev_num
	[range(0,15)] scalar:int8	# num_auths
	array(fixed=6) scalar:uint8	# id_auth
	array(fixed=15) scalar:uint32	# sub_auths
}

struct policy_handle align(4) {
	scalar:uint32	# handle_type
	struct:GUID	# uuid
}

struct rpcd_witness_registration align(8) {
	enum:witness_version	# version
	[charset(UTF8)] array(conformant,varying,zero_terminated) scalar:uint8	# net_name
	[charset(UTF8)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint8	# share_name
	[charset(UTF8)] array(conformant,varying,zero_terminated) scalar:uint8	# ip_address
	[charset(UTF8)] array(conformant,varying,zero_terminated) scalar:uint8	# client_computer_name
	bitmap:witness_RegisterEx_flags	# flags
	scalar:uint32	# timeout
	struct:policy_handle	# context_handle
	struct:server_id	# server_id
	[charset(UTF8)] array(conformant,varying,zero_terminated) scalar:uint8	# account_name
	[charset(UTF8)] array(conformant,varying,zero_terminated) scalar:uint8	# domain_name
	struct:dom_sid	# account_sid
	[charset(UTF8)] array(conformant,varying,zero_terminated) scalar:uint8	# local_address
	[charset(UTF8)] array(conformant,varying,zero_terminated) scalar:uint8	# remote_address
	scalar:NTTIME	# registration_time
}

struct rpcd_witness_registration_updateB align(5) {
	struct:policy_handle	# context_handle
	enum:rpcd_witness_registration_update_type	# type
	switch(type) union:rpcd_witness_registration_updateU	# update
}

union rpcd_witness_registration_updateU align(5) switch_type(enum:rpcd_witness_registration_update_type) {
	case(RPCD_WITNESS_REGISTRATION_UPDATE_CLIENT_MOVE_TO_NODE): struct:rpcd_witness_registration_update_move_to_node	# client_move_to_node
	case(RPCD_WITNESS_REGISTRATION_UPDATE_CLIENT_MOVE_TO_IPV4): struct:rpcd_witness_registration_update_move_to_ipv4	# client_move_to_ipv4
	case(RPCD_WITNESS_REGISTRATION_UPDATE_CLIENT_MOVE_TO_IPV6): struct:rpcd_witness_registration_update_move_to_ipv6	# client_move_to_ipv6
	case(RPCD_WITNESS_REGISTRATION_UPDATE_SHARE_MOVE_TO_NODE): struct:rpcd_witness_registration_update_move_to_node	# share_move_to_node
	case(RPCD_WITNESS_REGISTRATION_UPDATE_SHARE_MOVE_TO_IPV4): struct:rpcd_witness_registration_update_move_to_ipv4	# share_move_to_ipv4
	case(RPCD_WITNESS_REGISTRATION_UPDATE_SHARE_MOVE_TO_IPV6): struct:rpcd_witness_registration_update_move_to_ipv6	# share_move_to_ipv6
	case(RPCD_WITNESS_REGISTRATION_UPDATE_FORCE_UNREGISTER): EMPTY
	case(RPCD_WITNESS_REGISTRATION_UPDATE_FORCE_RESPONSE): struct:rpcd_witness_registration_update_force_response	# force_response
}

struct rpcd_witness_registration_update_force_response align(5) {
	ptr(unique) struct:witness_notifyResponse	# response
	scalar:WERROR	# result
}

struct rpcd_witness_registration_update_move_to_ipv4 align(4) {
	[flag(LIBNDR_FLAG_BIGENDIAN)] scalar:ipv4address	# new_ipv4
}

struct rpcd_witness_registration_update_move_to_ipv6 align(4) {
	[flag(LIBNDR_FLAG_BIGENDIAN)] scalar:ipv6address	# new_ipv6
}

struct rpcd_witness_registration_update_move_to_node align(4) {
	scalar:uint32	# new_node
}

enum rpcd_witness_registration_update_type base(uint16) {
	0x0001	# RPCD_WITNESS_REGISTRATION_UPDATE_CLIENT_MOVE_TO_NODE
	0x0002	# RPCD_WITNESS_REGISTRATION_UPDATE_CLIENT_MOVE_TO_IPV4
	0x0003	# RPCD_WITNESS_REGISTRATION_UPDATE_CLIENT_MOVE_TO_IPV6
	0x0004	# RPCD_WITNESS_REGISTRATION_UPDATE_SHARE_MOVE_TO_NODE
	0x0005	# RPCD_WITNESS_REGISTRATION_UPDATE_SHARE_MOVE_TO_IPV4
	0x0006	# RPCD_WITNESS_REGISTRATION_UPDATE_SHARE_MOVE_TO_IPV6
	0x0007	# RPCD_WITNESS_REGISTRATION_UPDATE_FORCE_UNREGISTER
	0x0008	# RPCD_WITNESS_REGISTRATION_UPDATE_FORCE_RESPONSE
}

struct server_id align(8) {
	scalar:hyper	# pid
	scalar:uint32	# task_id
	scalar:uint32	# vnn
	scalar:hyper	# unique_id
}

[flag(LIBNDR_FLAG_NOALIGN|LIBNDR_FLAG_LITTLE_ENDIAN)] struct witness_IPaddrInfo align(4) {
	bitmap:witness_IPaddrInfo_flags	# flags
	[flag(LIBNDR_FLAG_BIGENDIAN)] scalar:ipv4address	# ipv4
	[flag(LIBNDR_FLAG_BIGENDIAN)] scalar:ipv6address	# ipv6
}

[flag(LIBNDR_FLAG_NOALIGN|LIBNDR_FLAG_LITTLE_ENDIAN)] struct witness_IPaddrInfoList align(4) {
	[value(ndr_size_witness_IPaddrInfoList(r,ndr->flags))] scalar:uint32	# length
	[value(0)] scalar:uint32	# reserved
	scalar:uint32	# num
	array(inline=num) struct:witness_IPaddrInfo	# addr
}

bitmap witness_IPaddrInfo_flags base(uint32) {
	0	# WITNESS_IPADDR_V4 ( 0x01 )
	1	# WITNESS_IPADDR_V6 ( 0x02 )
	2	# WITNESS_IPADDR_ONLINE ( 0x08 )
	3	# WITNESS_IPADDR_OFFLINE ( 0x10 )
}

bitmap witness_RegisterEx_flags base(uint32) {
	0	# WITNESS_REGISTER_NONE ( 0x00 )
	1	# WITNESS_REGISTER_IP_NOTIFICATION ( 0x01 )
}

[flag(LIBNDR_FLAG_NOALIGN|LIBNDR_FLAG_LITTLE_ENDIAN)] struct witness_ResourceChange align(4) {
	[value(ndr_size_witness_ResourceChange(r,ndr->flags))] scalar:uint32	# length
	enum:witness_ResourceChange_type	# type
	[flag(LIBNDR_FLAG_STR_NULLTERM|LIBNDR_FLAG_ALIGN2)] scalar:string	# name
}

[flag(LIBNDR_PRINT_ARRAY_HEX)] enum witness_ResourceChange_type base(uint32) {
	0x00	# WITNESS_RESOURCE_STATE_UNKNOWN
	0x01	# WITNESS_RESOURCE_STATE_AVAILABLE
	0xff	# WITNESS_RESOURCE_STATE_UNAVAILABLE
}

[flag(LIBNDR_PRINT_ARRAY_HEX),nopull,nopush] struct witness_notifyResponse align(5) {
	enum:witness_notifyResponse_type	# type
	[value(ndr_size_witness_notifyResponse(r,ndr->flags)-20)] scalar:uint32	# length
	scalar:uint32	# num
	[flag(LIBNDR_FLAG_REMAINING)] ptr(unique) array(conformant=num) subcontext(4,length) switch(type) union:witness_notifyResponse_message	# messages
}

[flag(LIBNDR_FLAG_NOALIGN|LIBNDR_FLAG_LITTLE_ENDIAN),nodiscriminant] union witness_notifyResponse_message align(4) {
	case(WITNESS_NOTIFY_RESOURCE_CHANGE): struct:witness_ResourceChange	# resource_change
	case(WITNESS_NOTIFY_CLIENT_MOVE): struct:witness_IPaddrInfoList	# client_move
	case(WITNESS_NOTIFY_SHARE_MOVE): struct:witness_IPaddrInfoList	# share_move
	case(WITNESS_NOTIFY_IP_CHANGE): struct:witness_IPaddrInfoList	# ip_change
	default: [flag(LIBNDR_FLAG_REMAINING)] scalar:DATA_BLOB	# data
}

enum witness_notifyResponse_type base(uint32) {
	1	# WITNESS_NOTIFY_RESOURCE_CHANGE
	2	# WITNESS_NOTIFY_CLIENT_MOVE
	3	# WITNESS_NOTIFY_SHARE_MOVE
	4	# WITNESS_NOTIFY_IP_CHANGE
}

[flag(LIBNDR_PRINT_ARRAY_HEX)] enum witness_version base(uint32) {
	0x00010001	# WITNESS_V1
	0x00020000	# WITNESS_V2
	0xFFFFFFFF	# WITNESS_UNSPECIFIED_VERSION
}

