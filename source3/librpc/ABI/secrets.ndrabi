# NDR wire format ABI of secrets.idl
#
# This is the output of ndr_abi_secrets (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root TRUSTED_DOM_PASS
root lsa_secret
root secrets_domain_info1
root secrets_domain_infoB
root secrets_domain_sid
root secrets_domain_guid

struct CLAIM_SECURITY_ATTRIBUTE_RELATIVE_V1 align(5) {
	[flag(LIBNDR_FLAG_STR_NULLTERM|LIBNDR_FLAG_ALIGN2)] ptr(relative) scalar:string	# name
	scalar:uint16	# value_type
	scalar:uint32	# flags
	scalar:uint32	# value_count
	array(inline=value_count) switch(value_type) union:claim_values	# values
}

struct GUID align(4) {
	scalar:uint32	# time_low
	scalar:uint16	# time_mid
	scalar:uint16	# time_hi_and_version
	array(fixed=2) scalar:uint8	# clock_seq
	array(fixed=6) scalar:uint8	# node
}

[flag(LIBNDR_FLAG_NOALIGN)] struct TRUSTED_DOM_PASS align(4) {
	[value(strlen_m_term(uni_name))] scalar:uint32	# uni_name_len
	[charset(UTF16)] array(fixed=32) scalar:uint16	# uni_name
	[value(strlen(pass))] scalar:uint32	# pass_len
	[flag(LIBNDR_FLAG_STR_ASCII|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# pass
	scalar:time_t	# mod_time
	struct:dom_sid	# domain_sid
}

[flag(LIBNDR_FLAG_NOALIGN),nodiscriminant] union claim_values align(5) {
	case(CLAIM_SECURITY_ATTRIBUTE_TYPE_INT64): ptr(relative) scalar:int64	# int_value
	case(CLAIM_SECURITY_ATTRIBUTE_TYPE_UINT64): ptr(relative) scalar:hyper	# uint_value
	case(CLAIM_SECURITY_ATTRIBUTE_TYPE_STRING): [flag(LIBNDR_FLAG_STR_NULLTERM|LIBNDR_FLAG_ALIGN2)] ptr(relative) scalar:string	# string_value
	case(CLAIM_SECURITY_ATTRIBUTE_TYPE_SID): ptr(relative) scalar:DATA_BLOB	# sid_value
	case(CLAIM_SECURITY_ATTRIBUTE_TYPE_OCTET_STRING): ptr(relative) scalar:DATA_BLOB	# octet_value
	case(CLAIM_SECURITY_ATTRIBUTE_TYPE_BOOLEAN): ptr(relative) scalar:hyper	# uint_value
}

[nopull,nopush] struct dom_sid align(4) {
	scalar:uint8	# sid_rev_num
	[range(0,15)] scalar:int8	# num_auths
	array(fixed=6) scalar:uint8	# id_auth
	array(fixed=15) scalar:uint32	# sub_auths
}

external dom_sid2

external dom_sid68

bitmap kerb_EncTypes base(uint32) {
	0	# KERB_ENCTYPE_DES_CBC_CRC ( 0x00000001 )
	1	# KERB_ENCTYPE_DES_CBC_MD5 ( 0x00000002 )
	2	# KERB_ENCTYPE_RC4_HMAC_MD5 ( 0x00000004 )
	3	# KERB_ENCTYPE_AES128_CTS_HMAC_SHA1_96 ( 0x00000008 )
	4	# KERB_ENCTYPE_AES256_CTS_HMAC_SHA1_96 ( 0x00000010 )
	5	# KERB_ENCTYPE_AES256_CTS_HMAC_SHA1_96_SK ( 0x00000020 )
	6	# KERB_ENCTYPE_FAST_SUPPORTED ( 0x00010000 )
	7	# KERB_ENCTYPE_COMPOUND_IDENTITY_SUPPORTED ( 0x00020000 )
	8	# KERB_ENCTYPE_CLAIMS_SUPPORTED ( 0x00040000 )
	9	# KERB_ENCTYPE_RESOURCE_SID_COMPRESSION_DISABLED ( 0x00080000 )
}

struct lsa_DnsDomainInfo align(5) {
	struct:lsa_StringLarge	# name
	struct:lsa_StringLarge	# dns_domain
	struct:lsa_StringLarge	# dns_forest
	struct:GUID	# domain_guid
	ptr(unique) external:dom_sid2	# sid
}

struct lsa_ForestTrustBinaryData align(5) {
	[range(0,131072)] scalar:uint3264	# length
	ptr(unique) array(conformant=length) scalar:uint8	# data
}

union lsa_ForestTrustData align(5) switch_type(enum:lsa_ForestTrustRecordType) {
	case(LSA_FOREST_TRUST_TOP_LEVEL_NAME): struct:lsa_StringLarge	# top_level_name
	case(LSA_FOREST_TRUST_TOP_LEVEL_NAME_EX): struct:lsa_StringLarge	# top_level_name_ex
	case(LSA_FOREST_TRUST_DOMAIN_INFO): struct:lsa_ForestTrustDomainInfo	# domain_info
	default: struct:lsa_ForestTrustBinaryData	# data
}

struct lsa_ForestTrustDomainInfo align(5) {
	ptr(unique) external:dom_sid2	# domain_sid
	struct:lsa_StringLarge	# dns_domain_name
	struct:lsa_StringLarge	# netbios_domain_name
}

struct lsa_ForestTrustInformation align(5) {
	[range(0,4000)] scalar:uint32	# count
	ptr(unique) array(conformant=count) ptr(unique) struct:lsa_ForestTrustRecord	# entries
}

struct lsa_ForestTrustRecord align(8) {
	bitmap:lsa_ForestTrustRecordFlags	# flags
	enum:lsa_ForestTrustRecordType	# type
	scalar:NTTIME_hyper	# time
	switch(type) union:lsa_ForestTrustData	# forest_trust_data
}

bitmap lsa_ForestTrustRecordFlags base(uint32) {
	0	# LSA_TLN_DISABLED_NEW ( 0x00000001 )
	1	# LSA_TLN_DISABLED_ADMIN ( 0x00000002 )
	2	# LSA_TLN_DISABLED_CONFLICT ( 0x00000004 )
	3	# LSA_SID_DISABLED_ADMIN ( 0x00000001 )
	4	# LSA_SID_DISABLED_CONFLICT ( 0x00000002 )
	5	# LSA_NB_DISABLED_ADMIN ( 0x00000004 )
	6	# LSA_NB_DISABLED_CONFLICT ( 0x00000008 )
}

enum lsa_ForestTrustRecordType base(uint1632) {
	0	# LSA_FOREST_TRUST_TOP_LEVEL_NAME
	1	# LSA_FOREST_TRUST_TOP_LEVEL_NAME_EX
	2	# LSA_FOREST_TRUST_DOMAIN_INFO
	3	# LSA_FOREST_TRUST_BINARY_DATA
	4	# LSA_FOREST_TRUST_SCANNER_INFO
}

struct lsa_StringLarge align(5) {
	[value(2*strlen_m(string))] scalar:uint16	# length
	[value(2*strlen_m_term(string))] scalar:uint16	# size
	[charset(UTF16)] ptr(unique) array(conformant=size/2,varying=length/2) scalar:uint16	# string
}

bitmap lsa_TrustAttributes base(uint32) {
	0	# LSA_TRUST_ATTRIBUTE_NON_TRANSITIVE ( 0x00000001 )
	1	# LSA_TRUST_ATTRIBUTE_UPLEVEL_ONLY ( 0x00000002 )
	2	# LSA_TRUST_ATTRIBUTE_QUARANTINED_DOMAIN ( 0x00000004 )
	3	# LSA_TRUST_ATTRIBUTE_FOREST_TRANSITIVE ( 0x00000008 )
	4	# LSA_TRUST_ATTRIBUTE_CROSS_ORGANIZATION ( 0x00000010 )
	5	# LSA_TRUST_ATTRIBUTE_WITHIN_FOREST ( 0x00000020 )
	6	# LSA_TRUST_ATTRIBUTE_TREAT_AS_EXTERNAL ( 0x00000040 )
	7	# LSA_TRUST_ATTRIBUTE_USES_RC4_ENCRYPTION ( 0x00000080 )
	8	# LSA_TRUST_ATTRIBUTE_CROSS_ORGANIZATION_NO_TGT_DELEGATION ( 0x00000200 )
	9	# LSA_TRUST_ATTRIBUTE_PIM_TRUST ( 0x00000400 )
	10	# LSA_TRUST_ATTRIBUTE_CROSS_ORGANIZATION_ENABLE_TGT_DELEGATION ( 0x00000800 )
}

enum lsa_TrustType base(uint32) {
	0x00000001	# LSA_TRUST_TYPE_DOWNLEVEL
	0x00000002	# LSA_TRUST_TYPE_UPLEVEL
	0x00000003	# LSA_TRUST_TYPE_MIT
	0x00000004	# LSA_TRUST_TYPE_DCE
}

struct lsa_secret align(5) {
	ptr(unique) scalar:DATA_BLOB	# secret_current
	scalar:NTTIME	# secret_current_lastchange
	ptr(unique) scalar:DATA_BLOB	# secret_old
	scalar:NTTIME	# secret_old_lastchange
	ptr(unique) struct:security_descriptor	# sd
}

enum netr_SchannelType base(uint1632) {
	0	# SEC_CHAN_NULL
	1	# SEC_CHAN_LOCAL
	2	# SEC_CHAN_WKSTA
	3	# SEC_CHAN_DNS_DOMAIN
	4	# SEC_CHAN_DOMAIN
	5	# SEC_CHAN_LANMAN
	6	# SEC_CHAN_BDC
	7	# SEC_CHAN_RODC
}

bitmap netr_TrustFlags base(uint32) {
	0	# NETR_TRUST_FLAG_IN_FOREST ( 0x00000001 )
	1	# NETR_TRUST_FLAG_OUTBOUND ( 0x00000002 )
	2	# NETR_TRUST_FLAG_TREEROOT ( 0x00000004 )
	3	# NETR_TRUST_FLAG_PRIMARY ( 0x00000008 )
	4	# NETR_TRUST_FLAG_NATIVE ( 0x00000010 )
	5	# NETR_TRUST_FLAG_INBOUND ( 0x00000020 )
	6	# NETR_TRUST_FLAG_MIT_KRB5 ( 0x00000080 )
	7	# NETR_TRUST_FLAG_AES ( 0x00000100 )
}

[flag(LIBNDR_PRINT_ARRAY_HEX)] struct samr_Password align(1) {
	[flag(LIBNDR_FLAG_IS_SECRET)] array(fixed=16) scalar:uint8	# hash
}

struct secrets_domain_guid align(4) {
	struct:GUID	# guid
}

struct secrets_domain_info1 align(8) {
	[value(0)] scalar:hyper	# reserved_flags
	scalar:NTTIME	# join_time
	[charset(UTF16)] array(conformant,varying,zero_terminated) scalar:uint16	# computer_name
	[charset(UTF16)] array(conformant,varying,zero_terminated) scalar:uint16	# account_name
	enum:netr_SchannelType	# secure_channel_type
	struct:lsa_DnsDomainInfo	# domain_info
	bitmap:netr_TrustFlags	# trust_flags
	enum:lsa_TrustType	# trust_type
	bitmap:lsa_TrustAttributes	# trust_attributes
	[value(NULL)] ptr(unique) struct:lsa_ForestTrustInformation	# reserved_routing
	bitmap:kerb_EncTypes	# supported_enc_types
	[charset(UTF16)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint16	# salt_principal
	scalar:NTTIME	# password_last_change
	scalar:hyper	# password_changes
	ptr(unique) struct:secrets_domain_info1_change	# next_change
	ptr(ref) struct:secrets_domain_info1_password	# password
	ptr(unique) struct:secrets_domain_info1_password	# old_password
	ptr(unique) struct:secrets_domain_info1_password	# older_password
}

struct secrets_domain_info1_change align(5) {
	scalar:NTSTATUS	# local_status
	scalar:NTSTATUS	# remote_status
	scalar:NTTIME	# change_time
	[charset(UTF16)] array(conformant,varying,zero_terminated) scalar:uint16	# change_server
	ptr(ref) struct:secrets_domain_info1_password	# password
}

struct secrets_domain_info1_kerberos_key align(4) {
	scalar:uint32	# keytype
	scalar:uint32	# iteration_count
	[flag(LIBNDR_FLAG_IS_SECRET)] scalar:DATA_BLOB	# value
}

struct secrets_domain_info1_password align(5) {
	scalar:NTTIME	# change_time
	[charset(UTF16)] array(conformant,varying,zero_terminated) scalar:uint16	# change_server
	[flag(LIBNDR_FLAG_IS_SECRET)] scalar:DATA_BLOB	# cleartext_blob
	[flag(LIBNDR_FLAG_IS_SECRET)] struct:samr_Password	# nt_hash
	[charset(UTF16)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint16	# salt_data
	scalar:uint32	# default_iteration_count
	scalar:uint16	# num_keys
	array(inline=num_keys) struct:secrets_domain_info1_kerberos_key	# keys
}

struct secrets_domain_infoB align(5) {
	enum:secrets_domain_info_version	# version
	[value(0)] scalar:uint32	# reserved
	switch(version) union:secrets_domain_infoU	# info
}

union secrets_domain_infoU align(5) switch_type(scalar:uint32) {
	case(SECRETS_DOMAIN_INFO_VERSION_1): ptr(unique) struct:secrets_domain_info1	# info1
	default: EMPTY
}

enum secrets_domain_info_version base(uint32) {
	0x00000001	# SECRETS_DOMAIN_INFO_VERSION_1
}

struct secrets_domain_sid align(4) {
	external:dom_sid68	# sid
}

[nopull,nopush] struct security_ace align(5) {
	enum:security_ace_type	# type
	bitmap:security_ace_flags	# flags
	[value(ndr_size_security_ace(r,ndr->flags))] scalar:uint16	# size
	scalar:uint32	# access_mask
	switch(sec_ace_object(type)) union:security_ace_object_ctr	# object
	struct:dom_sid	# trustee
	subcontext(0,ndr_subcontext_size_of_ace_coda(r,size,ndr->flags)) switch(type) union:security_ace_coda	# coda
}

[nodiscriminant] union security_ace_coda align(5) {
	case(SEC_ACE_TYPE_ACCESS_ALLOWED_CALLBACK): [flag(LIBNDR_FLAG_REMAINING)] scalar:DATA_BLOB	# conditions
	case(SEC_ACE_TYPE_ACCESS_DENIED_CALLBACK): [flag(LIBNDR_FLAG_REMAINING)] scalar:DATA_BLOB	# conditions
	case(SEC_ACE_TYPE_ACCESS_ALLOWED_CALLBACK_OBJECT): [flag(LIBNDR_FLAG_REMAINING)] scalar:DATA_BLOB	# conditions
	case(SEC_ACE_TYPE_ACCESS_DENIED_CALLBACK_OBJECT): [flag(LIBNDR_FLAG_REMAINING)] scalar:DATA_BLOB	# conditions
	case(SEC_ACE_TYPE_SYSTEM_AUDIT_CALLBACK): [flag(LIBNDR_FLAG_REMAINING)] scalar:DATA_BLOB	# conditions
	case(SEC_ACE_TYPE_SYSTEM_AUDIT_CALLBACK_OBJECT): [flag(LIBNDR_FLAG_REMAINING)] scalar:DATA_BLOB	# conditions
	case(SEC_ACE_TYPE_SYSTEM_RESOURCE_ATTRIBUTE): struct:CLAIM_SECURITY_ATTRIBUTE_RELATIVE_V1	# claim
	default: [flag(LIBNDR_FLAG_REMAINING)] scalar:DATA_BLOB	# ignored
}

bitmap security_ace_flags base(uint8) {
	0	# SEC_ACE_FLAG_OBJECT_INHERIT ( 0x01 )
	1	# SEC_ACE_FLAG_CONTAINER_INHERIT ( 0x02 )
	2	# SEC_ACE_FLAG_NO_PROPAGATE_INHERIT ( 0x04 )
	3	# SEC_ACE_FLAG_INHERIT_ONLY ( 0x08 )
	4	# SEC_ACE_FLAG_INHERITED_ACE ( 0x10 )
	5	# SEC_ACE_FLAG_VALID_INHERIT ( 0x0f )
	6	# SEC_ACE_FLAG_SUCCESSFUL_ACCESS ( 0x40 )
	7	# SEC_ACE_FLAG_FAILED_ACCESS ( 0x80 )
}

struct security_ace_object align(4) {
	bitmap:security_ace_object_flags	# flags
	switch(flags&SEC_ACE_OBJECT_TYPE_PRESENT) union:security_ace_object_type	# type
	switch(flags&SEC_ACE_INHERITED_OBJECT_TYPE_PRESENT) union:security_ace_object_inherited_type	# inherited_type
}

[nodiscriminant] union security_ace_object_ctr align(4) {
	default: struct:security_ace_object	# object
	case(false): EMPTY
}

bitmap security_ace_object_flags base(uint32) {
	0	# SEC_ACE_OBJECT_TYPE_PRESENT ( 0x00000001 )
	1	# SEC_ACE_INHERITED_OBJECT_TYPE_PRESENT ( 0x00000002 )
}

[nodiscriminant] union security_ace_object_inherited_type align(4) {
	case(SEC_ACE_INHERITED_OBJECT_TYPE_PRESENT): struct:GUID	# inherited_type
	default: EMPTY
}

[nodiscriminant] union security_ace_object_type align(4) {
	case(SEC_ACE_OBJECT_TYPE_PRESENT): struct:GUID	# type
	default: EMPTY
}

enum security_ace_type base(uint8) {
	0	# SEC_ACE_TYPE_ACCESS_ALLOWED
	1	# SEC_ACE_TYPE_ACCESS_DENIED
	2	# SEC_ACE_TYPE_SYSTEM_AUDIT
	3	# SEC_ACE_TYPE_SYSTEM_ALARM
	4	# SEC_ACE_TYPE_ALLOWED_COMPOUND
	5	# SEC_ACE_TYPE_ACCESS_ALLOWED_OBJECT
	6	# SEC_ACE_TYPE_ACCESS_DENIED_OBJECT
	7	# SEC_ACE_TYPE_SYSTEM_AUDIT_OBJECT
	8	# SEC_ACE_TYPE_SYSTEM_ALARM_OBJECT
	9	# SEC_ACE_TYPE_ACCESS_ALLOWED_CALLBACK
	10	# SEC_ACE_TYPE_ACCESS_DENIED_CALLBACK
	11	# SEC_ACE_TYPE_ACCESS_ALLOWED_CALLBACK_OBJECT
	12	# SEC_ACE_TYPE_ACCESS_DENIED_CALLBACK_OBJECT
	13	# SEC_ACE_TYPE_SYSTEM_AUDIT_CALLBACK
	14	# SEC_ACE_TYPE_SYSTEM_ALARM_CALLBACK
	15	# SEC_ACE_TYPE_SYSTEM_AUDIT_CALLBACK_OBJECT
	16	# SEC_ACE_TYPE_SYSTEM_ALARM_CALLBACK_OBJECT
	17	# SEC_ACE_TYPE_SYSTEM_MANDATORY_LABEL
	18	# SEC_ACE_TYPE_SYSTEM_RESOURCE_ATTRIBUTE
	19	# SEC_ACE_TYPE_SYSTEM_SCOPED_POLICY_ID
}

struct security_acl align(5) {
	enum:security_acl_revision	# revision
	[value(ndr_size_security_acl(r,ndr->flags))] scalar:uint16	# size
	[range(0,2000)] scalar:uint32	# num_aces
	array(inline=num_aces) struct:security_ace	# aces
}

enum security_acl_revision base(uint1632) {
	2	# SECURITY_ACL_REVISION_NT4
	4	# SECURITY_ACL_REVISION_ADS
}

[flag(LIBNDR_FLAG_LITTLE_ENDIAN)] struct security_descriptor align(5) {
	enum:security_descriptor_revision	# revision
	bitmap:security_descriptor_type	# type
	ptr(relative) struct:dom_sid	# owner_sid
	ptr(relative) struct:dom_sid	# group_sid
	ptr(relative) struct:security_acl	# sacl
	ptr(relative) struct:security_acl	# dacl
}

enum security_descriptor_revision base(uint8) {
	1	# SECURITY_DESCRIPTOR_REVISION_1
}

bitmap security_descriptor_type base(uint16) {
	0	# SEC_DESC_OWNER_DEFAULTED ( 0x0001 )
	1	# SEC_DESC_GROUP_DEFAULTED ( 0x0002 )
	2	# SEC_DESC_DACL_PRESENT ( 0x0004 )
	3	# SEC_DESC_DACL_DEFAULTED ( 0x0008 )
	4	# SEC_DESC_SACL_PRESENT ( 0x0010 )
	5	# SEC_DESC_SACL_DEFAULTED ( 0x0020 )
	6	# SEC_DESC_DACL_TRUSTED ( 0x0040 )
	7	# SEC_DESC_SERVER_SECURITY ( 0x0080 )
	8	# SEC_DESC_DACL_AUTO_INHERIT_REQ ( 0x0100 )
	9	# SEC_DESC_SACL_AUTO_INHERIT_REQ ( 0x0200 )
	10	# SEC_DESC_DACL_AUTO_INHERITED ( 0x0400 )
	11	# SEC_DESC_SACL_AUTO_INHERITED ( 0x0800 )
	12	# SEC_DESC_DACL_PROTECTED ( 0x1000 )
	13	# SEC_DESC_SACL_PROTECTED ( 0x2000 )
	14	# SEC_DESC_RM_CONTROL_VALID ( 0x4000 )
	15	# SEC_DESC_SELF_RELATIVE ( 0x8000 )
}

