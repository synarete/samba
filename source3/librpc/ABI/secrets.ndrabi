	[0040] 00 00 00 00 0e 00 00 00  73 74 72 69 6e 67 30 30
	[0050] 30 30 30 30 30 32 00 03  04 05 06 01 04 00 00 00
	[0060] 00 00 05 04 05 06 07 05  06 07 08 06 07 08 09 07
