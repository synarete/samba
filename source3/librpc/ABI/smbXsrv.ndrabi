# NDR wire format ABI of smbXsrv.idl
#
# This is the output of ndr_abi_smbXsrv (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root smbXsrv_version_values
root smbXsrv_version_globalB
root smbXsrv_client_globalB
root smbXsrv_connection_passB
root smbXsrv_connection_dropB
root smbXsrv_encryption_flags
root smbXsrv_signing_flags
root smbXsrv_session_globalB
root smbXsrv_session_closeB
root smbXsrv_tcon_globalB
root smbXsrv_open_flags
root smbXsrv_open_globalB
root smbXsrv_open_replay_cache_key
root smbXsrv_open_replay_cache

struct CLAIM_SECURITY_ATTRIBUTE_RELATIVE_V1 align(5) {
	[flag(LIBNDR_FLAG_STR_NULLTERM|LIBNDR_FLAG_ALIGN2)] ptr(relative) scalar:string	# name
	scalar:uint16	# value_type
	scalar:uint32	# flags
	scalar:uint32	# value_count
	array(inline=value_count) switch(value_type) union:claim_values	# values
}

struct GUID align(4) {
	scalar:uint32	# time_low
	scalar:uint16	# time_mid
	scalar:uint16	# time_hi_and_version
	array(fixed=2) scalar:uint8	# clock_seq
	array(fixed=6) scalar:uint8	# node
}

struct auth_session_info align(5) {
	ptr(unique) struct:security_token	# security_token
	ptr(unique) struct:security_unix_token	# unix_token
	ptr(unique) struct:auth_user_info	# info
	ptr(unique) struct:auth_user_info_unix	# unix_info
	[value(NULL)] ptr(ignore) void	# torture
	scalar:DATA_BLOB	# session_key
	[value(NULL)] ptr(ignore) void	# credentials
	struct:GUID	# unique_session_token
	enum:ticket_type	# ticket_type
}

struct auth_user_info align(5) {
	[charset(UTF8)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint8	# account_name
	[charset(UTF8)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint8	# user_principal_name
	scalar:uint8	# user_principal_constructed
	[charset(UTF8)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint8	# domain_name
	[charset(UTF8)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint8	# dns_domain_name
	[charset(UTF8)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint8	# full_name
	[charset(UTF8)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint8	# logon_script
	[charset(UTF8)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint8	# profile_path
	[charset(UTF8)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint8	# home_directory
	[charset(UTF8)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint8	# home_drive
	[charset(UTF8)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint8	# logon_server
	scalar:NTTIME	# last_logon
	scalar:NTTIME	# last_logoff
	scalar:NTTIME	# acct_expiry
	scalar:NTTIME	# last_password_change
	scalar:NTTIME	# allow_password_change
	scalar:NTTIME	# force_password_change
	scalar:uint16	# logon_count
	scalar:uint16	# bad_password_count
	scalar:uint32	# acct_flags
	scalar:uint32	# user_flags
}

struct auth_user_info_unix align(5) {
	[charset(UTF8)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint8	# unix_name
	[charset(UTF8)] ptr(unique) array(conformant,varying,zero_terminated) scalar:uint8	# sanitized_username
}

[flag(LIBNDR_FLAG_NOALIGN),nodiscriminant] union claim_values align(5) {
	case(CLAIM_SECURITY_ATTRIBUTE_TYPE_INT64): ptr(relative) scalar:int64	# int_value
	case(CLAIM_SECURITY_ATTRIBUTE_TYPE_UINT64): ptr(relative) scalar:hyper	# uint_value
	case(CLAIM_SECURITY_ATTRIBUTE_TYPE_STRING): [flag(LIBNDR_FLAG_STR_NULLTERM|LIBNDR_FLAG_ALIGN2)] ptr(relative) scalar:string	# string_value
	case(CLAIM_SECURITY_ATTRIBUTE_TYPE_SID): ptr(relative) scalar:DATA_BLOB	# sid_value
	case(CLAIM_SECURITY_ATTRIBUTE_TYPE_OCTET_STRING): ptr(relative) scalar:DATA_BLOB	# octet_value
	case(CLAIM_SECURITY_ATTRIBUTE_TYPE_BOOLEAN): ptr(relative) scalar:hyper	# uint_value
}

enum claims_evaluation_control base(uint1632) {
	0	# CLAIMS_EVALUATION_INVALID_STATE
	1	# CLAIMS_EVALUATION_NEVER
	2	# CLAIMS_EVALUATION_ALWAYS
}

[nopull,nopush] struct dom_sid align(4) {
	scalar:uint8	# sid_rev_num
	[range(0,15)] scalar:int8	# num_auths
	array(fixed=6) scalar:uint8	# id_auth
	array(fixed=15) scalar:uint32	# sub_auths
}

struct file_id align(4) {
	scalar:udlong	# devid
	scalar:udlong	# inode
	scalar:udlong	# extid
}

bitmap lsa_SystemAccessModeFlags base(uint32) {
	0	# LSA_POLICY_MODE_INTERACTIVE ( 0x00000001 )
	1	# LSA_POLICY_MODE_NETWORK ( 0x00000002 )
	2	# LSA_POLICY_MODE_BATCH ( 0x00000004 )
	3	# LSA_POLICY_MODE_SERVICE ( 0x00000010 )
	4	# LSA_POLICY_MODE_PROXY ( 0x00000020 )
	5	# LSA_POLICY_MODE_DENY_INTERACTIVE ( 0x00000040 )
	6	# LSA_POLICY_MODE_DENY_NETWORK ( 0x00000080 )
	7	# LSA_POLICY_MODE_DENY_BATCH ( 0x00000100 )
	8	# LSA_POLICY_MODE_DENY_SERVICE ( 0x00000200 )
	9	# LSA_POLICY_MODE_REMOTE_INTERACTIVE ( 0x00000400 )
	10	# LSA_POLICY_MODE_DENY_REMOTE_INTERACTIVE ( 0x00000800 )
	11	# LSA_POLICY_MODE_ALL ( 0x00000FF7 )
	12	# LSA_POLICY_MODE_ALL_NT4 ( 0x00000037 )
}

bitmap se_privilege base(hyper) {
	0	# SEC_PRIV_MACHINE_ACCOUNT_BIT ( 0x00000010 )
	1	# SEC_PRIV_PRINT_OPERATOR_BIT ( 0x00000020 )
	2	# SEC_PRIV_ADD_USERS_BIT ( 0x00000040 )
	3	# SEC_PRIV_DISK_OPERATOR_BIT ( 0x00000080 )
	4	# SEC_PRIV_REMOTE_SHUTDOWN_BIT ( 0x00000100 )
	5	# SEC_PRIV_BACKUP_BIT ( 0x00000200 )
	6	# SEC_PRIV_RESTORE_BIT ( 0x00000400 )
	7	# SEC_PRIV_TAKE_OWNERSHIP_BIT ( 0x00000800 )
	8	# SEC_PRIV_INCREASE_QUOTA_BIT ( 0x00001000 )
	9	# SEC_PRIV_SECURITY_BIT ( 0x00002000 )
	10	# SEC_PRIV_LOAD_DRIVER_BIT ( 0x00004000 )
	11	# SEC_PRIV_SYSTEM_PROFILE_BIT ( 0x00008000 )
	12	# SEC_PRIV_SYSTEMTIME_BIT ( 0x00010000 )
	13	# SEC_PRIV_PROFILE_SINGLE_PROCESS_BIT ( 0x00020000 )
	14	# SEC_PRIV_INCREASE_BASE_PRIORITY_BIT ( 0x00040000 )
	15	# SEC_PRIV_CREATE_PAGEFILE_BIT ( 0x00080000 )
	16	# SEC_PRIV_SHUTDOWN_BIT ( 0x00100000 )
	17	# SEC_PRIV_DEBUG_BIT ( 0x00200000 )
	18	# SEC_PRIV_SYSTEM_ENVIRONMENT_BIT ( 0x00400000 )
	19	# SEC_PRIV_CHANGE_NOTIFY_BIT ( 0x00800000 )
	20	# SEC_PRIV_UNDOCK_BIT ( 0x01000000 )
	21	# SEC_PRIV_ENABLE_DELEGATION_BIT ( 0x02000000 )
	22	# SEC_PRIV_MANAGE_VOLUME_BIT ( 0x04000000 )
	23	# SEC_PRIV_IMPERSONATE_BIT ( 0x08000000 )
	24	# SEC_PRIV_CREATE_GLOBAL_BIT ( 0x10000000 )
}

struct security_token align(8) {
	scalar:uint32	# num_sids
	array(conformant=num_sids) struct:dom_sid	# sids
	bitmap:se_privilege	# privilege_mask
	bitmap:lsa_SystemAccessModeFlags	# rights_mask
	scalar:uint32	# num_local_claims
	scalar:uint32	# num_user_claims
	scalar:uint32	# num_device_claims
	scalar:uint32	# num_device_sids
	array(conformant=num_local_claims) struct:CLAIM_SECURITY_ATTRIBUTE_RELATIVE_V1	# local_claims
	array(conformant=num_user_claims) struct:CLAIM_SECURITY_ATTRIBUTE_RELATIVE_V1	# user_claims
	array(conformant=num_device_claims) struct:CLAIM_SECURITY_ATTRIBUTE_RELATIVE_V1	# device_claims
	array(conformant=num_device_sids) struct:dom_sid	# device_sids
	enum:claims_evaluation_control	# evaluate_claims
}

struct security_unix_token align(8) {
	scalar:uid_t	# uid
	scalar:gid_t	# gid
	scalar:uint32	# ngroups
	array(conformant=ngroups,surrounding) scalar:gid_t	# groups
}

struct server_id align(8) {
	scalar:hyper	# pid
	scalar:uint32	# task_id
	scalar:uint32	# vnn
	scalar:hyper	# unique_id
}

struct smbXsrv_channel_global align(8) {
	struct:server_id	# server_id
	scalar:hyper	# channel_id
	scalar:NTTIME	# creation_time
	[charset(UTF8)] array(conformant,varying,zero_terminated) scalar:uint8	# local_address
	[charset(UTF8)] array(conformant,varying,zero_terminated) scalar:uint8	# remote_address
	[charset(UTF8)] array(conformant,varying,zero_terminated) scalar:uint8	# remote_name
	scalar:DATA_BLOB	# signing_key_blob
	ptr(ignore) void	# signing_key
	scalar:uint32	# auth_session_info_seqnum
	ptr(ignore) void	# connection
	scalar:uint16	# signing_algo
	scalar:uint16	# encryption_cipher
	scalar:uint8	# transport_type
}

struct smbXsrv_client_global align(8) {
	ptr(ignore) void	# db_rec
	struct:server_id	# server_id
	[charset(UTF8)] array(conformant,varying,zero_terminated) scalar:uint8	# local_address
	[charset(UTF8)] array(conformant,varying,zero_terminated) scalar:uint8	# remote_address
	[charset(UTF8)] array(conformant,varying,zero_terminated) scalar:uint8	# remote_name
	scalar:NTTIME	# initial_connect_time
	struct:GUID	# client_guid
	scalar:uint8	# stored
}

struct smbXsrv_client_globalB align(5) {
	enum:smbXsrv_version_values	# version
	scalar:uint32	# seqnum
	switch(version) union:smbXsrv_client_globalU	# info
}

union smbXsrv_client_globalU align(5) switch_type(scalar:uint32) {
	case(1): ptr(ref) struct:smbXsrv_client_global	# info1
	default: EMPTY
}

struct smbXsrv_connection_drop align(8) {
	struct:GUID	# client_guid
	struct:server_id	# src_server_id
	scalar:NTTIME	# xconn_connect_time
	struct:server_id	# dst_server_id
	scalar:NTTIME	# client_connect_time
}

struct smbXsrv_connection_dropB align(5) {
	enum:smbXsrv_version_values	# version
	[value(0)] scalar:uint32	# reserved
	switch(version) union:smbXsrv_connection_dropU	# info
}

union smbXsrv_connection_dropU align(5) switch_type(scalar:uint32) {
	case(1): ptr(ref) struct:smbXsrv_connection_drop	# info1
	default: EMPTY
}

struct smbXsrv_connection_pass align(8) {
	struct:GUID	# client_guid
	struct:server_id	# src_server_id
	scalar:NTTIME	# xconn_connect_time
	struct:server_id	# dst_server_id
	scalar:NTTIME	# client_connect_time
	scalar:uint8	# transport_type
	scalar:DATA_BLOB	# negotiate_request
}

struct smbXsrv_connection_passB align(5) {
	enum:smbXsrv_version_values	# version
	[value(0)] scalar:uint32	# reserved
	switch(version) union:smbXsrv_connection_passU	# info
}

union smbXsrv_connection_passU align(5) switch_type(scalar:uint32) {
	case(1): ptr(ref) struct:smbXsrv_connection_pass	# info1
	default: EMPTY
}

bitmap smbXsrv_encryption_flags base(uint8) {
	0	# SMBXSRV_ENCRYPTION_REQUIRED ( 0x01 )
	1	# SMBXSRV_ENCRYPTION_DESIRED ( 0x02 )
	2	# SMBXSRV_PROCESSED_ENCRYPTED_PACKET ( 0x04 )
	3	# SMBXSRV_PROCESSED_UNENCRYPTED_PACKET ( 0x08 )
}

bitmap smbXsrv_open_flags base(uint8) {
	0	# SMBXSRV_OPEN_NEED_REPLAY_CACHE ( 0x01 )
	1	# SMBXSRV_OPEN_HAVE_REPLAY_CACHE ( 0x02 )
}

struct smbXsrv_open_global align(8) {
	struct:server_id	# server_id
	scalar:hyper	# session_global_id
	scalar:uint32	# tcon_global_id
	scalar:uint32	# open_global_id
	scalar:hyper	# open_persistent_id
	scalar:hyper	# open_volatile_id
	struct:file_id	# file_id
	scalar:uint32	# name_hash
	struct:dom_sid	# open_owner
	scalar:NTTIME	# open_time
	struct:GUID	# create_guid
	struct:GUID	# client_guid
	struct:GUID	# app_instance_id
	scalar:hyper	# app_instance_vhigh
	scalar:hyper	# app_instance_vlow
	scalar:uint32	# create_action
	scalar:NTTIME	# disconnect_time
	scalar:uint32	# durable_timeout_msec
	scalar:uint8	# durable
	scalar:uint8	# persistent
	scalar:DATA_BLOB	# backend_cookie
	scalar:uint16	# channel_sequence
	scalar:hyper	# channel_generation
	[flag(LIBNDR_PRINT_ARRAY_HEX)] array(fixed=64) scalar:uint8	# lock_sequence_array
}

struct smbXsrv_open_globalB align(5) {
	enum:smbXsrv_version_values	# version
	scalar:uint32	# seqnum
	switch(version) union:smbXsrv_open_globalU	# info
}

union smbXsrv_open_globalU align(5) switch_type(scalar:uint32) {
	case(1): ptr(ref) struct:smbXsrv_open_global	# info1
	default: EMPTY
}

struct smbXsrv_open_replay_cache align(4) {
	scalar:DATA_BLOB	# open_global_key
}

struct smbXsrv_open_replay_cache_key align(4) {
	struct:GUID	# client_guid
	struct:GUID	# create_guid
}

struct smbXsrv_session_close align(8) {
	scalar:uint32	# old_session_global_id
	scalar:hyper	# old_session_wire_id
	scalar:NTTIME	# old_creation_time
	scalar:hyper	# new_session_wire_id
}

struct smbXsrv_session_closeB align(5) {
	enum:smbXsrv_version_values	# version
	[value(0)] scalar:uint32	# reserved
	switch(version) union:smbXsrv_session_closeU	# info
}

union smbXsrv_session_closeU align(5) switch_type(scalar:uint32) {
	case(1): ptr(ref) struct:smbXsrv_session_close	# info1
	default: EMPTY
}

struct smbXsrv_session_global align(8) {
	ptr(ignore) void	# db_rec
	scalar:uint32	# session_global_id
	scalar:hyper	# session_wire_id
	scalar:NTTIME	# creation_time
	scalar:NTTIME	# expiration_time
	scalar:NTTIME	# auth_time
	scalar:uint32	# auth_session_info_seqnum
	ptr(unique) struct:auth_session_info	# auth_session_info
	scalar:uint16	# connection_dialect
	struct:GUID	# client_guid
	bitmap:smbXsrv_signing_flags	# signing_flags
	scalar:uint16	# signing_algo
	bitmap:smbXsrv_encryption_flags	# encryption_flags
	scalar:uint16	# encryption_cipher
	scalar:DATA_BLOB	# signing_key_blob
	ptr(ignore) void	# signing_key
	scalar:DATA_BLOB	# encryption_key_blob
	ptr(ignore) void	# encryption_key
	scalar:DATA_BLOB	# decryption_key_blob
	ptr(ignore) void	# decryption_key
	scalar:DATA_BLOB	# application_key_blob
	ptr(ignore) void	# application_key
	[range(1,1024)] scalar:uint32	# num_channels
	array(inline=num_channels) struct:smbXsrv_channel_global	# channels
}

struct smbXsrv_session_globalB align(5) {
	enum:smbXsrv_version_values	# version
	scalar:uint32	# seqnum
	switch(version) union:smbXsrv_session_globalU	# info
}

union smbXsrv_session_globalU align(5) switch_type(scalar:uint32) {
	case(1): ptr(ref) struct:smbXsrv_session_global	# info1
	default: EMPTY
}

bitmap smbXsrv_signing_flags base(uint8) {
	0	# SMBXSRV_SIGNING_REQUIRED ( 0x01 )
	1	# SMBXSRV_PROCESSED_SIGNED_PACKET ( 0x02 )
	2	# SMBXSRV_PROCESSED_UNSIGNED_PACKET ( 0x04 )
}

struct smbXsrv_tcon_global align(8) {
	ptr(ignore) void	# db_rec
	scalar:uint32	# tcon_global_id
	scalar:uint32	# tcon_wire_id
	struct:server_id	# server_id
	scalar:NTTIME	# creation_time
	[charset(UTF8)] array(conformant,varying,zero_terminated) scalar:uint8	# share_name
	bitmap:smbXsrv_encryption_flags	# encryption_flags
	scalar:uint32	# session_global_id
	bitmap:smbXsrv_signing_flags	# signing_flags
}

struct smbXsrv_tcon_globalB align(5) {
	enum:smbXsrv_version_values	# version
	scalar:uint32	# seqnum
	switch(version) union:smbXsrv_tcon_globalU	# info
}

union smbXsrv_tcon_globalU align(5) switch_type(scalar:uint32) {
	case(1): ptr(ref) struct:smbXsrv_tcon_global	# info1
	default: EMPTY
}

struct smbXsrv_version_global align(8) {
	[range(1,1024)] scalar:uint32	# num_nodes
	array(inline=num_nodes) struct:smbXsrv_version_node	# nodes
}

struct smbXsrv_version_globalB align(5) {
	enum:smbXsrv_version_values	# version
	scalar:uint32	# seqnum
	switch(version) union:smbXsrv_version_globalU	# info
}

union smbXsrv_version_globalU align(5) switch_type(scalar:uint32) {
	case(1): ptr(ref) struct:smbXsrv_version_global	# info1
	default: EMPTY
}

struct smbXsrv_version_node align(8) {
	struct:server_id	# server_id
	enum:smbXsrv_version_values	# min_version
	enum:smbXsrv_version_values	# max_version
	enum:smbXsrv_version_values	# current_version
}

enum smbXsrv_version_values base(uint32) {
	0x00000001	# SMBXSRV_VERSION_1
}

enum ticket_type base(uint1632) {
	0	# TICKET_TYPE_UNKNOWN
	1	# TICKET_TYPE_TGT
	2	# TICKET_TYPE_NON_TGT
}

