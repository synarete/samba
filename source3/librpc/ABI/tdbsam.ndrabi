# NDR wire format ABI of tdbsam.idl
#
# This is the output of ndr_abi_tdbsam (generated by
# 'pidl --ndr-abi'), see librpc/ndr/ndr_abi.h.
#
# Lines starting with '#' and everything after '\t#'
# are comments, they are not compared.

root tdbsam_version_rec
root tdbsam_next_rid_rec
root tdbsam_rid_rec
root tdbsam_user_v3

[flag(LIBNDR_FLAG_NOALIGN)] struct tdbsam_blob align(4) {
	scalar:uint32	# length
	array(inline=length) scalar:uint8	# data
}

[flag(LIBNDR_FLAG_NOALIGN)] struct tdbsam_next_rid_rec align(4) {
	scalar:uint32	# rid
}

[flag(LIBNDR_FLAG_NOALIGN)] struct tdbsam_rid_rec align(4) {
	[flag(LIBNDR_FLAG_STR_RAW8|LIBNDR_FLAG_STR_NULLTERM)] scalar:string	# name
}

[flag(LIBNDR_FLAG_NOALIGN)] struct tdbsam_user_v3 align(4) {
	scalar:uint32	# logon_time
	scalar:uint32	# logoff_time
	scalar:uint32	# kickoff_time
	scalar:uint32	# bad_password_time
	scalar:uint32	# pass_last_set_time
	scalar:uint32	# pass_can_change_time
	scalar:uint32	# pass_must_change_time
	struct:tdbsam_blob	# username
	struct:tdbsam_blob	# domain
	struct:tdbsam_blob	# nt_username
	struct:tdbsam_blob	# fullname
	struct:tdbsam_blob	# homedir
	struct:tdbsam_blob	# dir_drive
	struct:tdbsam_blob	# logon_script
	struct:tdbsam_blob	# profile_path
	struct:tdbsam_blob	# acct_desc
	struct:tdbsam_blob	# workstations
	struct:tdbsam_blob	# comment
	struct:tdbsam_blob	# munged_dial
	scalar:uint32	# user_rid
	scalar:uint32	# group_rid
	struct:tdbsam_blob	# lm_pw
	struct:tdbsam_blob	# nt_pw
	struct:tdbsam_blob	# nt_pw_hist
	scalar:uint32	# acct_ctrl
	scalar:uint16	# logon_divs
	scalar:uint32	# hours_len
	struct:tdbsam_blob	# hours
	scalar:uint16	# bad_password_count
	scalar:uint16	# logon_count
	scalar:uint32	# unknown_6
}

[flag(LIBNDR_FLAG_NOALIGN)] struct tdbsam_version_rec align(4) {
	scalar:int32	# version
}

sample tdbsam_version_rec length(4) {
	[0000] 01 02 03 04
}
#	    tdbsam_version_rec: struct tdbsam_version_rec
#	        version                  : 67305985

sample tdbsam_next_rid_rec length(4) {
	[0000] 01 02 03 04
}
#	    tdbsam_next_rid_rec: struct tdbsam_next_rid_rec
#	        rid                      : 0x04030201 (67305985)

sample tdbsam_rid_rec length(15) {
	[0000] 73 74 72 69 6e 67 30 30  30 30 30 30 30 31 00
}
#	    tdbsam_rid_rec: struct tdbsam_rid_rec
#	        name                     : 'string00000001'

