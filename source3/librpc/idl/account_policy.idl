#include "idl_types.h"

/*
 * The record formats of account_policy.tdb used by
 * source3/passdb/account_pol.c and source3/lib/privileges.c
 *
 * They are hand-marshalled (little endian), this describes
 * them in order to protect them with [ndr_abi], the
 * equivalence is verified by LOCAL-ACCOUNT-POLICY-WIRE-FORMAT
 * (source3/torture/test_tdb_wire_formats.c).
 *
 * account_policy.tdb is a persistent database, which is
 * shared by all nodes with clustering = yes.
 *
 * The record keys include the terminating nul byte.
 */

[
	/*
	 * The NDR wire format of all [public] types
	 * and everything they use is protected by
	 * source3/librpc/ABI/account_policy.ndrabi,
	 * see librpc/ndr/ndr_abi.h
	 */
	ndr_abi,
	pointer_default(unique)
]
interface account_policy
{
	/*
	 * INFO/version and the policies with their names
	 * as key (e.g. "min password length") stored with
	 * dbwrap_store_uint32_bystring().
	 */
	typedef [public,flag(NDR_NOALIGN)] struct {
		uint32 value;
	} account_policy_value_rec;

	/*
	 * PRIV_<sid> contains the se_privilege mask
	 * stored with SBVAL().
	 *
	 * Old records with an old style SE_PRIV structure
	 * (16 bytes) are only read.
	 */
	typedef [public,flag(NDR_NOALIGN)] struct {
		hyper privileges;
	} account_policy_privileges_rec;
}
