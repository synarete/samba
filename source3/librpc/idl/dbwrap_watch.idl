#include "idl_types.h"

import "server_id.idl";

/*
 * The record format used by source3/lib/dbwrap/dbwrap_watch.c
 *
 * It is hand-marshalled with server_id_put() and SBVAL/SIVAL
 * (little endian) for performance reasons, this describes
 * it in order to protect it with [ndr_abi], the
 * equivalence is verified by LOCAL-G-LOCK-WIRE-FORMAT
 * (source3/torture/test_g_lock.c).
 *
 * It is used in clustered databases like smbXsrv_*_global.tdb
 * and also wraps the NDR payloads stored there.
 */

[
	/*
	 * The NDR wire format of all [public] types
	 * and everything they use is protected by
	 * source3/librpc/ABI/dbwrap_watch.ndrabi,
	 * see librpc/ndr/ndr_abi.h
	 */
	ndr_abi,
	pointer_default(unique)
]
interface dbwrap_watch
{
	typedef [public,flag(NDR_NOALIGN)] struct {
		server_id pid;
		hyper instance;
	} dbwrap_watcher_rec;

	typedef [public,flag(NDR_NOALIGN)] struct {
		uint32 num_watchers;
		dbwrap_watcher_rec watchers[num_watchers];
		[flag(NDR_REMAINING)] DATA_BLOB data;
	} dbwrap_watch_rec;

	/*
	 * The payload of MSG_DBWRAP_MODIFIED, which wakes up
	 * a watcher (also on other nodes of a cluster), see
	 * dbwrap_watched_trigger_wakeup(). It is the instance
	 * of the dbwrap_watcher_rec, hand-marshalled with SBVAL
	 * (little endian).
	 */
	const uint32 DBWRAP_WATCH_MODIFIED_MSG_SIZE = 8;
	typedef [public,flag(NDR_NOALIGN)] struct {
		hyper instance;
	} dbwrap_watch_modified_msg;
}
