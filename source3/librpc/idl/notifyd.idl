#include "idl_types.h"

import "server_id.idl";

/*
 * The messages exchanged between smbd and notifyd, also
 * between notifyd instances on different ctdb nodes
 * (directly or within a messaging_reclog broadcast).
 *
 * Each message consists of a fixed size header described
 * here, followed by a nul terminated path.
 *
 * The headers used to be raw C structures in host byte order,
 * the NDR representations have exactly the same layout on
 * LP64 platforms if marshalled with LIBNDR_FLAG_HOST_BYTE_ORDER,
 * other platforms still use the raw C structures.
 *
 * Once cluster level 2.0 is active the *_LE message types
 * (e.g. MSG_SMB_NOTIFY_REC_CHANGE_LE) are used, the headers
 * are little endian on all platforms then.
 */

[
	/*
	 * The NDR wire format of all [public] types
	 * and everything they use is protected by
	 * source3/librpc/ABI/notifyd.ndrabi,
	 * see librpc/ndr/ndr_abi.h
	 */
	ndr_abi,
	pointer_default(unique)
]
interface notifyd
{
	/*
	 * struct timespec, as it was used in the raw C structures
	 */
	typedef [public,flag(NDR_NOALIGN)] struct {
		int64 tv_sec;
		int64 tv_nsec;
	} notifyd_timespec;

	/*
	 * MSG_SMB_NOTIFY_REC_CHANGE header
	 *
	 * private_data is the opaque (pointer) value
	 * of the client.
	 */
	const uint32 NOTIFY_REC_CHANGE_HDR_SIZE = 32;
	typedef [public,flag(NDR_NOALIGN)] struct {
		notifyd_timespec creation_time;
		uint32 filter;
		uint32 subdir_filter;
		hyper private_data;
	} notify_rec_change_hdr;

	/*
	 * MSG_SMB_NOTIFY_TRIGGER header
	 */
	const uint32 NOTIFY_TRIGGER_HDR_SIZE = 24;
	typedef [public,flag(NDR_NOALIGN)] struct {
		notifyd_timespec when;
		uint32 action;
		uint32 filter;
	} notify_trigger_hdr;

	/*
	 * MSG_PVFS_NOTIFY header
	 */
	const uint32 NOTIFY_EVENT_HDR_SIZE = 28;
	typedef [public,flag(NDR_NOALIGN)] struct {
		notifyd_timespec when;
		hyper private_data;
		uint32 action;
	} notify_event_hdr;

	/*
	 * MSG_SMB_NOTIFY_DB contains a hyper (the index of the
	 * reclog), followed by dbwrap_marshall() of a database with
	 * the paths as keys. The values are a notifyd_watcher_rec
	 * followed by notifyd_instance_rec elements.
	 *
	 * The in memory database of notifyd uses the raw C
	 * structures (struct notifyd_watcher and struct
	 * notifyd_instance), which have exactly the same layout
	 * on LP64 platforms if marshalled with
	 * LIBNDR_FLAG_HOST_BYTE_ORDER, other platforms still
	 * use the raw C structures.
	 *
	 * Once cluster level 2.0 is active MSG_SMB_NOTIFY_DB_LE
	 * is used instead, which has the same content, but
	 * notifyd_watcher_rec and notifyd_instance_rec are
	 * little endian on all platforms.
	 */
	const uint32 NOTIFYD_WATCHER_REC_SIZE = 24;
	typedef [public,flag(NDR_NOALIGN)] struct {
		uint32 filter;
		uint32 subdir_filter;
		uint32 sys_filter;
		uint32 sys_subdir_filter;
		/* opaque local handle, ignored by the receiver */
		hyper sys_watch;
	} notifyd_watcher_rec;

	const uint32 NOTIFYD_INSTANCE_REC_SIZE = 56;
	typedef [public,flag(NDR_NOALIGN)] struct {
		server_id client;
		notify_rec_change_hdr instance;
	} notifyd_instance_rec;
}
