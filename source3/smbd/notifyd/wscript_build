#!/usr/bin/env python

bld.SAMBA3_SUBSYSTEM('notifyd_msg',
                     source='notifyd_msg.c',
                     deps='samba-debug ndr NDR_NOTIFYD samba-cluster-support')

bld.SAMBA3_SUBSYSTEM('fcn_wait',
                     source='fcn_wait.c',
                     deps='samba3core notifyd_msg')

bld.SAMBA3_SUBSYSTEM('notifyd_db',
		     source='notifyd_entry.c notifyd_db.c',
                     deps='samba-debug dbwrap errors3 notifyd_msg')

bld.SAMBA3_SUBSYSTEM('notifyd',
		     source='notifyd.c',
                     deps='''
                         util_tdb
                         TDB_LIB
                         messages_util
                         notifyd_db
                         notifyd_msg
                     ''')

bld.SAMBA3_BINARY('notifyd-tests',
                  source='tests.c',
                  install=False,
                  deps='''
                       smbconf
                       notifyd_msg
                       NDR_MESSAGING
                  ''')

bld.SAMBA3_BINARY('notifydd',
                  source='notifydd.c',
                  install=False,
                  deps='''notifyd
                       smbconf
                  ''')

TORTURE_NOTIFYD_SOURCE='test_notifyd.c'
TORTURE_NOTIFYD_DEPS='fcn_wait notifyd_db notifyd_msg'

bld.SAMBA_MODULE('TORTURE_NOTIFYD',
	source=TORTURE_NOTIFYD_SOURCE,
	subsystem='smbtorture',
	init_function='torture_notifyd_init',
	deps=TORTURE_NOTIFYD_DEPS,
	internal_module=True,
	enabled=bld.PYTHON_BUILD_IS_ENABLED()
	)
